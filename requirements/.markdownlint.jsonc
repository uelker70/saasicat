// Link fragments are resolved in the document these files become, not in the
// file they are written in: a chapter may point at an entry three chapters
// away, and in `docs/requirements.md` that anchor is right there. MD051 sees
// one chapter at a time and calls every such link broken.
//
// The check is not dropped, it moves. `scripts/requirements/check.mjs` resolves
// every fragment against the headings of the whole catalogue, which is more
// than MD051 could do here even if it agreed with the split.
{
    "extends": "../.markdownlint.jsonc",
    "MD051": false,
    // The front matter `title` becomes `## <n>. <title>` when the page is
    // assembled (`scripts/requirements/render.mjs`), which is why the entries
    // below it are `###`. MD001 reads a front-matter title as an H1 and would
    // ask for an H2 first; with no title to read, it still checks that the
    // headings actually in the file increment one level at a time.
    "MD001": { "front_matter_title": "" },
}
