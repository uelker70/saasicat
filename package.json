{
    "name": "saasicat-workspace",
    "version": "0.1.0",
    "private": true,
    "description": "Connect code capabilities to SaaS packages, customer contracts and runtime enforcement in NestJS apps.",
    "engines": {
        "node": "^24.0.0",
        "pnpm": ">=10"
    },
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "test:repo": "node --test tests/*.test.js",
        "typecheck": "pnpm -r typecheck",
        "lint": "eslint .",
        "lint:css": "stylelint \"packages/ui-vue/src/{pages,features,internal}/**/*.{vue,css}\" \"packages/ui-vue-tenant/src/**/*.{vue,css}\" --max-warnings 625",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "release:version": "changeset version && node scripts/stamp-spec-version.mjs",
        "coverage": "node scripts/build-if-stale.mjs && node scripts/coverage-ratchet.mjs",
        "coverage:update": "node scripts/build-if-stale.mjs && node scripts/coverage-ratchet.mjs --update",
        "tokens": "node scripts/token-audit.mjs",
        "tokens:update": "node packages/ui-vue/tests/design-token-budget.test.js --update"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^10.0.1",
        "eslint": "^10.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-regexp": "^3.2.0",
        "eslint-plugin-saasicat": "workspace:*",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.6.0",
        "postcss-html": "^2.0.0",
        "prettier": "^3.8.1",
        "stylelint": "^17.14.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1",
        "vue": "^3.5.0",
        "vue-eslint-parser": "^10.4.1",
        "yaml": "^2.9.0"
    },
    "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
