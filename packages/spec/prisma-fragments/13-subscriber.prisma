// =============================================================================
// SaaS platform Prisma fragment: Subscriber, its tenants, its corrections,
// the changes of its tax origin, the checks of its VAT id
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// A tenant is where the application keeps a customer's data. The subscriber is
// the party the contract is with: a customer number and the master data a
// contract names. A tenant can be deleted; its subscriber stays for as long as
// a document that has to be kept belongs to it (ADR 0012). That is why nothing
// here points at the application's `Tenant` model with a cascade — the link
// below names the tenant as a value and stays after the tenant row is gone.
//
// Every model carries `Subscriber` in its name, so it cannot collide with a
// `Customer` an application already keeps for the people it sells to.

model Subscriber {
    id String @id @default(uuid())

    // The customer number, counted per installation. The number orders; the
    // prefix is the one `config/saas.yaml` named when the subscriber was
    // created, kept beside it so a later prefix renames nobody. Counting starts
    // at 10001 (sql/constraints.postgres.sql), so numbers have five digits long
    // before they need a sixth.
    customerSequence     Int    @unique @default(autoincrement())
    customerNumberPrefix String @default("")

    // The legal identity. Only the name is required until invoicing requires
    // the rest; under a running contract these change only as a correction,
    // recorded in `SubscriberCorrection`.
    legalName String
    vatId     String?
    taxNumber String?

    // The tax origin beside the country and the VAT id (ADR 0013): whether the
    // subscriber is a business, as sign-up or the operator recorded it — null
    // while nobody has said, and never derived from a tax identifier, since a
    // business outside the European Union may have none. A change of the
    // country, the business status or the VAT id is recorded in
    // `SubscriberTaxOriginChange`.
    business Boolean?

    // Which recorded check of the VAT id counts now (`SubscriberVatIdCheck`):
    // the latest completed one of the number the subscriber has. Null while
    // none does — never checked, or the number corrected since. A reference
    // without a relation: the check already points at its subscriber, and a
    // key in both directions would tie each row to the other.
    currentVatIdCheckId String?
    // Since when the VAT id is held, set by the correction that wrote it; null
    // while it is the one the subscriber was created with. A check completed
    // before it does not count for the number.
    vatIdSince          DateTime?

    // Contact details, which change at any time.
    addressLine1 String?
    addressLine2 String?
    postalCode   String?
    city         String?
    country      String? // ISO 3166-1 alpha-2
    invoiceEmail String?

    // Created by the migration that gave every existing tenant its subscriber,
    // from the application's own tenant record.
    migrated Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tenants             SubscriberTenant[]
    corrections         SubscriberCorrection[]
    taxOriginChanges    SubscriberTaxOriginChange[]
    vatIdChecks         SubscriberVatIdCheck[]
    contracts           SubscriptionContract[]
    paymentMethods      SubscriberPaymentMethod[] // see 14-payments.prisma
    paymentMethodSetups SubscriberPaymentMethodSetup[]
    ledgerEntries       SubscriberLedgerEntry[] // see 15-subscriber-ledger.prisma

    @@map("subscribers")
}

// Which tenant a subscriber is live for, and which it was before. A subscriber
// has at most one live tenant and a tenant at most one live subscriber — two
// partial unique indexes in sql/constraints.postgres.sql, which Prisma cannot
// express. `unlinkedAt` stays null while the link is live.
model SubscriberTenant {
    id           String    @id @default(uuid())
    subscriberId String
    tenantId     String
    linkedAt     DateTime  @default(now())
    unlinkedAt   DateTime?

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([tenantId])
    @@index([subscriberId])
    @@map("subscriber_tenants")
}

// A correction of a subscriber's legal identity: the values it replaced, the
// values it wrote, why, who made it, and when the write held the subscriber's
// lock. Only the fields that moved are in the two JSON objects. Written in the
// same transaction as the change, and never rewritten.
model SubscriberCorrection {
    id           String   @id @default(uuid())
    // The order the corrections were written in, numbered by the database at
    // the write, and the order the list is read in. Never set by the platform.
    seq          Int      @unique @default(autoincrement())
    subscriberId String
    previous     Json
    corrected    Json
    reason       String
    correctedBy  String
    correctedAt  DateTime

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([subscriberId, seq])
    @@map("subscriber_corrections")
}

// A change of a subscriber's tax origin — its country, whether it is a
// business, its VAT id — whichever way it arrived: a contact change, a
// correction of the legal identity, a change of the business status. The
// values it replaced, the values it wrote, who made it, and when the write
// held the subscriber's lock; only the fields that moved are in the two JSON
// objects. Written in the same transaction as the change, never rewritten, and
// applied from the subscriber's next invoice.
model SubscriberTaxOriginChange {
    id           String   @id @default(uuid())
    // The order the changes were written in, numbered by the database at the
    // write, and the order the list is read in. Never set by the platform.
    seq          Int      @unique @default(autoincrement())
    subscriberId String
    previous     Json
    changed      Json
    changedBy    String
    changedAt    DateTime

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([subscriberId, seq])
    @@map("subscriber_tax_origin_changes")
}

// A completed check of a subscriber's VAT id, as the service answered it: the
// number checked, when the answer came, whether it found the number valid, the
// service and its confirmation. Recorded for every check, whether it counts or
// not, and never rewritten: a reverse charge rests on the confirmation that
// held when the invoice was issued (ADR 0013).
model SubscriberVatIdCheck {
    id           String   @id @default(uuid())
    subscriberId String
    vatId        String
    checkedAt    DateTime
    valid        Boolean
    service      String
    confirmation Json
    recordedAt   DateTime @default(now())

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([subscriberId, checkedAt])
    @@map("subscriber_vat_id_checks")
}
