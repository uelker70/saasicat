// =============================================================================
// SaaSiCat platform Prisma fragment: SubscriberPayment, SubscriptionInvoiceSettlement,
// SubscriberCredit, SubscriberCreditEntry, SubscriberRefund, SubscriberReversal,
// SubscriberReconciliationCase
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// What money moved between a subscriber and the operator. A payment is what
// the gateway confirmed for an invoice's collection attempt
// (23-subscription-invoice-collection.prisma), recorded once by its gateway
// account and the gateway's reference however often it is reported. What it
// settles of its invoice is a settlement of its own; what it brought beyond
// that, and an invoice whose total is negative, is a credit the subscriber is
// owed. A credit is never offset against a later invoice: the operator pays it
// out, by a refund in the gateway — recorded when the gateway reports it — or
// by a payout outside it, each an entry against the credit. A refund that
// fails or is canceled gives back what it paid out, as an entry of its own.
//
// A cancellation (20-subscription-invoice.prisma) moves what each payment
// settled of the cancelled invoice onto the replacement, as two settlements of
// that payment — `MOVED_OUT` of the one, `MOVED_IN` of the other —, the oldest
// payment first; what the replacement does not take is a credit that names both
// the payment and the cancellation, so a later reversal of the payment finds
// it as its own (`SC-PRIC-025`, `SC-PRIC-084`).
//
// A reversal — a direct debit the bank returned, a chargeback — takes back
// what its payment brought, the credit first: entries against the credit for
// its open part, and settlements that open the invoice again for the rest. The
// gateway giving it back writes the same entries the other way. What matches
// nothing — a refund no credit takes, a reversal that meets a credit already
// paid out — is a case for the operator to reconcile, closed with a note.
//
// Nothing here is updated but a refund's status, what a reversal withdrew and
// was given back, and a case's closing: every other change is a new row.
// `kind` and `status` are text holding closed sets, checked when a row is read
// (`toSubscriberCreditRecord` and the other readers in @saasicat/core), and so
// is a credit's origin — a payment, an invoice, a reversal, or a payment and
// the cancellation that moved it. A payment leaves at most one credit of its
// own and one per cancellation: two partial unique indexes in
// sql/constraints.postgres.sql, which the Prisma DSL cannot express.
//
// Optional, as one: adopt all seven where invoices are collected through a
// gateway — `tenantBilling.chargeJournal.invoices.payments` — beside the
// collection attempts, which every payment points at.
//
// Contract: @saasicat/core (SubscriberPaymentRepository).

model SubscriberPayment {
    id             String   @id @default(uuid())
    subscriberId   String
    // The tenant the invoice was for, as a trace; no relation to it.
    tenantId       String
    invoiceId      String
    collectionId   String
    gatewayAccount String
    provider       String
    // The gateway's own reference to the payment, unique within its account.
    gatewayRef     String
    amount         Decimal  @db.Decimal(12, 2)
    currency       String
    recordedAt     DateTime @default(now())

    subscriber  Subscriber                    @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    invoice     SubscriptionInvoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    collection  SubscriptionInvoiceCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
    settlements SubscriptionInvoiceSettlement[]
    credits     SubscriberCredit[]
    refunds     SubscriberRefund[]
    reversals   SubscriberReversal[]
    cases       SubscriberReconciliationCase[]

    @@unique([gatewayAccount, gatewayRef])
    @@index([invoiceId])
    @@index([subscriberId])
    @@map("subscriber_payments")
}

model SubscriptionInvoiceSettlement {
    id         String   @id @default(uuid())
    invoiceId  String
    paymentId  String
    kind       String // PAYMENT | REVERSAL | REINSTATEMENT | MOVED_OUT | MOVED_IN
    // Positive: what a PAYMENT, a REINSTATEMENT or a MOVED_IN takes off what
    // the invoice owes, what a REVERSAL or a MOVED_OUT adds back to it.
    amount     Decimal  @db.Decimal(12, 2)
    // The reversal, for a REVERSAL and its REINSTATEMENT.
    reversalId String?
    // The cancellation that moved it, for a MOVED_OUT and a MOVED_IN.
    cancellationId String?
    recordedAt DateTime @default(now())

    invoice      SubscriptionInvoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    payment      SubscriberPayment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    reversal     SubscriberReversal?              @relation(fields: [reversalId], references: [id], onDelete: Restrict)
    cancellation SubscriptionInvoiceCancellation? @relation(fields: [cancellationId], references: [id], onDelete: Restrict)

    @@index([invoiceId])
    @@index([paymentId])
    @@index([reversalId])
    @@index([cancellationId])
    @@map("subscription_invoice_settlements")
}

model SubscriberCredit {
    id              String   @id @default(uuid())
    subscriberId    String
    // The tenant it arose in, as a trace; no relation to it.
    tenantId        String
    // What the subscriber is owed, positive.
    amount          Decimal  @db.Decimal(12, 2)
    currency        String
    // The payment that brought more than its invoice owed, the invoice whose
    // total is negative, or the reversal the gateway gave back beyond what the
    // invoices it opened still owed — a reversal can be given back in parts,
    // so it can leave more than one. A credit a cancellation left names the
    // payment whose share the replacement did not take, and the cancellation.
    originPaymentId      String?
    originInvoiceId      String?  @unique
    originReversalId     String?
    originCancellationId String?
    createdAt            DateTime @default(now())

    subscriber         Subscriber                       @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    originPayment      SubscriberPayment?               @relation(fields: [originPaymentId], references: [id], onDelete: Restrict)
    originInvoice      SubscriptionInvoice?             @relation(fields: [originInvoiceId], references: [id], onDelete: Restrict)
    originReversal     SubscriberReversal?              @relation("ReversalCredits", fields: [originReversalId], references: [id], onDelete: Restrict)
    originCancellation SubscriptionInvoiceCancellation? @relation(fields: [originCancellationId], references: [id], onDelete: Restrict)
    entries            SubscriberCreditEntry[]

    @@index([subscriberId, createdAt])
    @@index([originPaymentId])
    @@index([originReversalId])
    @@unique([originCancellationId, originPaymentId])
    @@map("subscriber_credits")
}

model SubscriberCreditEntry {
    id         String    @id @default(uuid())
    creditId   String
    kind       String // REFUND | REFUND_FAILED | PAYOUT | REVERSAL | REVERSAL_TAKEN_BACK
    // Positive: what a REFUND, a PAYOUT or a REVERSAL pays out, what a
    // REFUND_FAILED or a REVERSAL_TAKEN_BACK gives back.
    amount     Decimal   @db.Decimal(12, 2)
    // The refund, for a REFUND and its REFUND_FAILED.
    refundId   String?
    // The reversal, for a REVERSAL and its REVERSAL_TAKEN_BACK.
    reversalId String?
    // A payout's: the transfer's reference, the day it left, who recorded it.
    reference  String?
    paidOn     DateTime? @db.Date
    recordedBy String?
    note       String?
    recordedAt DateTime  @default(now())

    credit   SubscriberCredit    @relation(fields: [creditId], references: [id], onDelete: Restrict)
    refund   SubscriberRefund?   @relation(fields: [refundId], references: [id], onDelete: Restrict)
    reversal SubscriberReversal? @relation(fields: [reversalId], references: [id], onDelete: Restrict)

    @@unique([refundId, creditId, kind])
    @@index([creditId])
    @@index([reversalId])
    @@map("subscriber_credit_entries")
}

model SubscriberRefund {
    id             String    @id @default(uuid())
    subscriberId   String
    paymentId      String
    gatewayAccount String
    // The gateway's own reference to the refund, unique within its account.
    gatewayRef     String
    amount         Decimal   @db.Decimal(12, 2)
    currency       String
    status         String // PENDING | SUCCEEDED | FAILED | CANCELED
    recordedAt     DateTime  @default(now())
    // When it was recorded as failed or canceled.
    endedAt        DateTime?

    subscriber Subscriber                     @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    payment    SubscriberPayment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    entries    SubscriberCreditEntry[]
    cases      SubscriberReconciliationCase[]

    @@unique([gatewayAccount, gatewayRef])
    @@index([paymentId])
    @@map("subscriber_refunds")
}

model SubscriberReversal {
    id                String    @id @default(uuid())
    subscriberId      String
    // The tenant the payment's invoice was for, as a trace; no relation to it.
    tenantId          String
    paymentId         String
    gatewayAccount    String
    // The gateway's own reference to it, such as a dispute's, unique within its account.
    gatewayRef        String
    // What the gateway withdrew so far, positive.
    amount            Decimal   @db.Decimal(12, 2)
    currency          String
    // The part of `amount` taken from the credit the payment left, open or paid out.
    fromCredit        Decimal   @db.Decimal(12, 2)
    // What the gateway gave back of `amount` so far, a dispute won.
    reinstated        Decimal   @db.Decimal(12, 2)
    // The part of `reinstated` that covered the reversal's cases, written as it is given back.
    reinstatedToCases Decimal   @default(0) @db.Decimal(12, 2)
    recordedAt        DateTime  @default(now())
    // When the gateway last gave something back.
    reinstatedAt      DateTime?

    subscriber  Subscriber                     @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    payment     SubscriberPayment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    settlements SubscriptionInvoiceSettlement[]
    entries     SubscriberCreditEntry[]
    credits     SubscriberCredit[]             @relation("ReversalCredits")
    cases       SubscriberReconciliationCase[]

    @@unique([gatewayAccount, gatewayRef])
    @@index([paymentId])
    @@map("subscriber_reversals")
}

model SubscriberReconciliationCase {
    id             String    @id @default(uuid())
    subscriberId   String
    // The tenant the payment's invoice was for, as a trace; no relation to it.
    tenantId       String
    kind           String // REFUND_UNMATCHED | REVERSAL_UNMATCHED
    // What matched nothing, positive.
    amount         Decimal   @db.Decimal(12, 2)
    currency       String
    paymentId      String
    // Exactly what its kind is about: the refund, or the reversal.
    refundId       String?
    reversalId     String?
    gatewayAccount String
    // The refund's or the reversal's reference at the gateway.
    gatewayRef     String
    recordedAt     DateTime  @default(now())
    // Closed with a note; `closedBy` is empty where SaaSiCat closed it.
    closedAt       DateTime?
    closedBy       String?
    note           String?

    subscriber Subscriber          @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    payment    SubscriberPayment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    refund     SubscriberRefund?   @relation(fields: [refundId], references: [id], onDelete: Restrict)
    reversal   SubscriberReversal? @relation(fields: [reversalId], references: [id], onDelete: Restrict)

    @@unique([refundId])
    @@index([reversalId])
    @@index([closedAt, recordedAt])
    @@index([subscriberId, closedAt])
    @@map("subscriber_reconciliation_cases")
}
