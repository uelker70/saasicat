// =============================================================================
// SaaS platform Prisma fragment: SubscriptionInvoice
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// The invoices issued from the charge journal (15-subscriber-ledger.prisma):
// the charges a billing period opens with on one invoice, a charge that arises
// later on an invoice of its own. An invoice copies everything it states when
// it is issued — the issuer, the subscriber, the tax treatment the adapter
// decided, the tax per rate — so a later change leaves it as it was. Nothing
// updates or deletes an invoice; a correction is a cancellation invoice and its
// replacement (`SubscriptionInvoiceCancellation`), written together.
//
// An invoice and the invoices that correct it are one chain (`SC-PRIC-036`):
// `chainId` names the invoice it began with — its own id for an invoice issued
// on the journal's charges — and `chainStep` its step there: 0 that invoice, 1
// its cancellation, 2 the replacement, 3 the replacement's cancellation and so
// on. Whatever changes what an invoice of a chain owes or how it is collected —
// a payment, a reversal, a cancellation, a collection attempt — takes the turn
// of the chain's first invoice, so two of them never read the same replacement
// at once.
//
// A line invoices one charge, and a charge stands on one line per step of a
// chain — the invoice it was first issued on, its cancellation, the
// replacement: the unique (`chargeId`, `chainStep`) is what makes a second run
// issuing the same charges write nothing, however many run at the same time.
//
// The number range is the table `subscription_invoice_numbers`, one row per
// year holding the last number drawn. An invoice draws its number by raising
// that row in the transaction that writes the invoice, so an invoice that
// fails to be written leaves no gap, and two at the same time wait for each
// other rather than drawing the same number. One installation is the range of
// one issuer; the number is `<prefix>-<year>-<sequence>`.
//
// The days an invoice states — its issue date, its due date, the period its
// charges cover, a direct debit's collection date — are calendar days in the
// installation's time zone, kept as `date` columns; `issuedAt` is the instant
// it was issued.
//
// `origin` and `source` on a line are text holding the charge's closed sets,
// checked when a row is read (`toSubscriptionInvoiceRecord` in @saasicat/core).
//
// Optional: adopt it, all five models together, where
// `tenantBilling.chargeJournal.invoices` is configured, which needs the charge
// journal.
//
// Contract: @saasicat/core (SubscriptionInvoiceRepository).

model SubscriptionInvoice {
    id             String @id @default(uuid())
    number         String @unique
    numberPrefix   String
    numberYear     Int
    numberSequence Int

    tenantId       String
    subscriberId   String
    subscriptionId String
    contractId     String

    chainId   String
    chainStep Int    @default(0)

    issuedAt           DateTime
    issueDate          DateTime @db.Date
    dueDate            DateTime @db.Date
    servicePeriodFrom  DateTime @db.Date
    servicePeriodUntil DateTime @db.Date

    // The payment method it is collected with, copied when it was issued —
    // its id, account, type and masked details, and a direct debit's mandate
    // reference; null where it is not collected. A direct debit's collection
    // date, which the invoice announces and falls due on; null otherwise.
    payment        Json?
    collectionDate DateTime? @db.Date

    currency        String
    // The parties as the invoice names them, copied when it was issued.
    issuerParty     Json
    subscriberParty Json
    // The footer lines config/saas.yaml named on the issue date (SC-PRIC-077).
    footer          Json    @default("[]")
    // The adapter's treatment, with its name and version, and the tax per rate.
    taxTreatment    Json
    taxes           Json
    totalNet        Decimal @db.Decimal(12, 2)
    totalTax        Decimal @db.Decimal(12, 2)
    totalGross      Decimal @db.Decimal(12, 2)
    // What a replacement took over, when it was issued, of what was paid for
    // the invoice it replaces (`SC-PRIC-025`); its document states it as paid.
    // Zero on every other invoice.
    paidOnIssue     Decimal @default(0) @db.Decimal(12, 2)

    createdAt DateTime @default(now())

    subscriber Subscriber                   @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    contract   SubscriptionContract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
    lines      SubscriptionInvoiceLine[]
    document    SubscriptionInvoiceDocument?
    archive     SubscriptionInvoiceArchive?
    collections SubscriptionInvoiceCollection[]
    payments    SubscriberPayment[]             // see 24-subscriber-payments.prisma
    settlements SubscriptionInvoiceSettlement[]
    credit      SubscriberCredit?

    chainStart    SubscriptionInvoice              @relation("SubscriptionInvoiceChain", fields: [chainId], references: [id], onDelete: Restrict)
    chainInvoices SubscriptionInvoice[]            @relation("SubscriptionInvoiceChain")
    cancelledBy   SubscriptionInvoiceCancellation? @relation("CancelledInvoice")
    cancels       SubscriptionInvoiceCancellation? @relation("CancellationInvoice")
    replaces      SubscriptionInvoiceCancellation? @relation("ReplacementInvoice")

    @@unique([numberYear, numberSequence])
    @@index([subscriberId, issuedAt])
    @@index([subscriptionId])
    @@index([chainId])
    @@map("subscription_invoices")
}

model SubscriptionInvoiceLine {
    id                 String @id @default(uuid())
    invoiceId          String
    position           Int
    chargeId           String
    contractLineItemId String
    // The step of its invoice in the chain.
    chainStep          Int    @default(0)
    // On a cancellation, the position of the line it cancels; on a replacement,
    // of the line it replaces, on the invoice the cancellation names
    // (`SC-AUD-013`). Null on an invoice's own line.
    correctedPosition  Int?

    title  String
    origin String
    source String

    periodFrom  DateTime @db.Date
    periodUntil DateTime @db.Date

    amountNet Decimal @db.Decimal(10, 2)
    taxRate   Decimal @db.Decimal(5, 2)

    invoice          SubscriptionInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    charge           SubscriberLedgerEntry @relation(fields: [chargeId], references: [id], onDelete: Restrict)
    contractLineItem ContractLineItem      @relation(fields: [contractLineItemId], references: [id], onDelete: Restrict)

    @@unique([chargeId, chainStep])
    @@unique([invoiceId, position])
    @@index([contractLineItemId])
    @@map("subscription_invoice_lines")
}

// A cancellation (`SC-PRIC-025`): the invoice it cancels, the cancellation
// invoice that does, and the replacement for what is still owed — none where
// nothing is —, written in one transaction with both invoices and the moving
// of what was paid (24-subscriber-payments.prisma). The operator's reason, the
// subscriber's details corrected for the replacement — each with the value it
// replaces —, an address to deliver to where the subscriber's record holds no
// invoice email (`SC-PRIC-047`), who cancelled and when. An invoice is
// cancelled once: the unique `cancelledInvoiceId` refuses a second.
model SubscriptionInvoiceCancellation {
    id                    String   @id @default(uuid())
    cancelledInvoiceId    String   @unique
    cancellationInvoiceId String   @unique
    replacementInvoiceId  String?  @unique
    reason                String
    correctedSubscriber   Json?
    deliverTo             String?
    cancelledBy           String
    cancelledAt           DateTime

    cancelledInvoice    SubscriptionInvoice             @relation("CancelledInvoice", fields: [cancelledInvoiceId], references: [id], onDelete: Restrict)
    cancellationInvoice SubscriptionInvoice             @relation("CancellationInvoice", fields: [cancellationInvoiceId], references: [id], onDelete: Restrict)
    replacementInvoice  SubscriptionInvoice?            @relation("ReplacementInvoice", fields: [replacementInvoiceId], references: [id], onDelete: Restrict)
    settlements         SubscriptionInvoiceSettlement[]
    credits             SubscriberCredit[]

    @@map("subscription_invoice_cancellations")
}

// Where an invoice's document stands. The checksum is recorded once, before
// the file is archived, and every later download is checked against it; the
// archive's confirmation and the delivery are set once each. A rendering with
// another checksum is refused rather than recorded over the first. A run claims
// the mail before it sends it, so of several instances one does.
model SubscriptionInvoiceDocument {
    invoiceId         String    @id
    // SHA-256 of the rendered file, 64 lower-case hex digits.
    checksum          String
    mediaType         String
    fileName          String
    // In bytes.
    size              Int
    renderedAt        DateTime
    // Null while the invoice waits for its document.
    archivedAt        DateTime?
    // When the run mailing it took it on; null while no run holds it.
    deliveryClaimedAt DateTime?
    // Null until the invoice is handed to the mail.
    deliveredAt       DateTime?
    deliveredTo       String?

    invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

    @@index([archivedAt])
    @@map("subscription_invoice_documents")
}

model SubscriptionInvoiceNumber {
    // The year the numbers count in; the range restarts at 1 each year.
    year Int @id
    // The last number drawn in that year.
    last Int

    @@map("subscription_invoice_numbers")
}
