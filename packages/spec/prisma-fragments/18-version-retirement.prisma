// =============================================================================
// SaaS platform Prisma fragment: VersionRetirement
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// One row per retirement an operator announces: a plan version ended for the
// subscriptions already on it, with the version they continue on. It is the one
// exception to a subscription keeping its version, so it is kept as evidence of
// what was announced, when and by whom.
//
// What it means for each subscription it reaches — the date it takes effect,
// the last day to cancel without notice, and to whom and how that was told — is
// a `subscription_notices` row of kind version-retired, written in the same
// transaction: its subject is the retired version, its content names this
// row's id as `retirementId`.
//
// The versions are kept as values, not as keys: the record outlives the
// catalogue entries it names, as the notices do (ADR 0012).
//
// Optional: adopt it where an operator may retire versions
// (`tenantBilling.orderlyRetirement` in config/saas.yaml), which refuses to
// start without a place to keep announcements.
//
// Contract: @saasicat/core (VersionRetirementRepository).

model VersionRetirement {
    id String @id @default(uuid())

    retiredPlanVersionId String
    retiredPlanKey       String
    retiredVersion       Int

    replacementPlanVersionId String
    replacementPlanKey       String
    replacementVersion       Int

    announcedAt DateTime @default(now())
    // Who announced it — an actor tag, as the audit log writes it.
    announcedBy String

    @@index([retiredPlanVersionId])
    @@map("version_retirements")
}
