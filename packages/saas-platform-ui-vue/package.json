{
    "name": "@saasicat/ui-vue",
    "version": "0.27.0",
    "description": "Vue 3 components, resource clients and composables for the SuperAdmin UI shell. Provides boot and manifest loaders, navigation, actions and standard pages.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./client": {
            "import": {
                "types": "./dist/client/index.d.ts",
                "default": "./dist/client/index.js"
            },
            "require": {
                "types": "./dist/client/index.d.cts",
                "default": "./dist/client/index.cjs"
            }
        },
        "./quasar": {
            "import": {
                "types": "./dist/quasar/index.d.ts",
                "default": "./dist/quasar/index.js"
            },
            "require": {
                "types": "./dist/quasar/index.d.cts",
                "default": "./dist/quasar/index.cjs"
            }
        },
        "./pages/*": "./src/pages/*",
        "./pages-standard/*": "./src/pages/*",
        "./pages-tenant/*": "./src/pages-tenant/*",
        "./theme.css": "./src/ui/theme/index.css",
        "./theme/breakpoints": "./src/ui/theme/_breakpoints.scss",
        "./theme/*": "./src/ui/theme/*",
        "./sa-theme.css": "./src/ui/theme/sa-theme.css",
        "./testing-e2e/*": {
            "import": {
                "types": "./dist/testing-e2e/*.d.ts",
                "default": "./dist/testing-e2e/*.js"
            },
            "require": {
                "types": "./dist/testing-e2e/*.d.cts",
                "default": "./dist/testing-e2e/*.cjs"
            }
        },
        "./ui/*": "./src/ui/*",
        "./layouts/*": "./src/layouts/*",
        "./auth/*": "./src/auth/*",
        "./components/FeatureGate.vue": "./src/ui/entitlement/FeatureGate.vue",
        "./components/KvBlock.vue": "./src/ui/data/KvBlock.vue",
        "./components/LocaleSwitcher.vue": "./src/ui/page/LocaleSwitcher.vue",
        "./components/MfaPromptDialog.vue": "./src/ui/overlay/MfaPromptDialog.vue",
        "./components/ThemeSwitcher.vue": "./src/ui/page/ThemeSwitcher.vue",
        "./components/admin-page/AdminAccordion.vue": "./src/ui/page/AdminAccordion.vue",
        "./components/admin-page/AdminBody.vue": "./src/ui/page/AdminBody.vue",
        "./components/admin-page/AdminFilters.vue": "./src/ui/page/AdminFilters.vue",
        "./components/admin-page/AdminHero.vue": "./src/ui/page/AdminHero.vue",
        "./components/admin-page/AdminKpi.vue": "./src/ui/data/AdminKpi.vue",
        "./components/admin-page/AdminPage.vue": "./src/ui/page/AdminPage.vue",
        "./components/admin-page/AdminPaginator.vue": "./src/ui/data/AdminPaginator.vue",
        "./components/admin-page/AdminRefreshBtn.vue": "./src/ui/feedback/AdminRefreshBtn.vue",
        "./components/admin-page/AdminSection.vue": "./src/ui/page/AdminSection.vue",
        "./components/admin-page/AdminStatistics.vue": "./src/ui/data/AdminStatistics.vue",
        "./components/admin-page/AdminTable.vue": "./src/ui/data/AdminTable.vue",
        "./components/wizard-stepper/WizardStepper.vue": "./src/ui/page/WizardStepper.vue",
        "./pages-standard/AdminLayout.vue": "./src/layouts/AdminLayout.vue",
        "./pages-standard/SuperAdminLoginPage.vue": "./src/auth/SuperAdminLoginPage.vue",
        "./pages-standard/SuperAdminSetupWizard.vue": "./src/auth/SuperAdminSetupWizard.vue",
        "./pages/AdminLayout.vue": "./src/layouts/AdminLayout.vue",
        "./pages/SuperAdminLoginPage.vue": "./src/auth/SuperAdminLoginPage.vue",
        "./pages/SuperAdminSetupWizard.vue": "./src/auth/SuperAdminSetupWizard.vue"
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "node ../../scripts/build-and-prune.mjs tsup",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.tests.json",
        "pretest": "pnpm run build",
        "test": "node --test tests/**/*.test.js",
        "test:component": "vitest run --config vitest.config.ts",
        "test:e2e": "playwright test",
        "test:visual": "playwright test --project=visual",
        "test:visual:update": "playwright test --project=visual --update-snapshots",
        "test:shipped-source": "node scripts/check-shipped-source.mjs"
    },
    "dependencies": {
        "@saasicat/types": "workspace:^"
    },
    "peerDependencies": {
        "pinia": "^2.0.0 || ^3.0.0",
        "quasar": "^2.22.0",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "pinia": {
            "optional": true
        },
        "quasar": {
            "optional": true
        },
        "vue-router": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@quasar/vite-plugin": "^1.12.0",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "axios": "^1.15.0",
        "jsdom": "^30.0.1",
        "pinia": "^3.0.0",
        "quasar": "^2.24.0",
        "sass": "^1.101.3",
        "tsup": "^8.0.0",
        "typescript": "^6.0.0",
        "vite": "^7.3.6",
        "vitest": "^4.1.10",
        "vue": "^3.5.0",
        "vue-router": "^5.0.0",
        "vue-tsc": "^3.3.3"
    },
    "license": "PolyForm-Shield-1.0.0",
    "author": "Taci Uelker",
    "homepage": "https://github.com/uelker70/saasicat",
    "repository": {
        "type": "git",
        "url": "https://github.com/uelker70/saasicat.git",
        "directory": "packages/saas-platform-ui-vue"
    },
    "bugs": {
        "url": "https://github.com/uelker70/saasicat/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
