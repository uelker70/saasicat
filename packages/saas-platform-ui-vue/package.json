{
    "name": "@saasicat/ui-vue",
    "version": "0.24.1",
    "description": "Vue 3 components, resource clients and composables for the SuperAdmin UI shell. Provides boot and manifest loaders, navigation, actions and standard pages.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./client": {
            "import": {
                "types": "./dist/client/index.d.ts",
                "default": "./dist/client/index.js"
            },
            "require": {
                "types": "./dist/client/index.d.cts",
                "default": "./dist/client/index.cjs"
            }
        },
        "./quasar": {
            "import": {
                "types": "./dist/quasar/index.d.ts",
                "default": "./dist/quasar/index.js"
            },
            "require": {
                "types": "./dist/quasar/index.d.cts",
                "default": "./dist/quasar/index.cjs"
            }
        },
        "./pages/*": "./src/pages-standard/*",
        "./pages-standard/*": "./src/pages-standard/*",
        "./pages-tenant/*": "./src/pages-tenant/*",
        "./components/*": "./src/components/*",
        "./theme.css": "./src/ui/theme/index.css",
        "./theme/breakpoints": "./src/ui/theme/_breakpoints.scss",
        "./theme/*": "./src/ui/theme/*",
        "./sa-theme.css": "./src/pages-standard/sa-theme.css",
        "./testing-e2e/*": {
            "import": {
                "types": "./dist/testing-e2e/*.d.ts",
                "default": "./dist/testing-e2e/*.js"
            },
            "require": {
                "types": "./dist/testing-e2e/*.d.cts",
                "default": "./dist/testing-e2e/*.cjs"
            }
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.tests.json",
        "pretest": "pnpm run build",
        "test": "node --test tests/**/*.test.js",
        "test:component": "vitest run --config vitest.config.ts",
        "test:e2e": "playwright test",
        "test:visual": "playwright test --project=visual",
        "test:visual:update": "playwright test --project=visual --update-snapshots"
    },
    "dependencies": {
        "@saasicat/types": "workspace:^"
    },
    "peerDependencies": {
        "pinia": "^2.0.0 || ^3.0.0",
        "quasar": "^2.22.0",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "pinia": {
            "optional": true
        },
        "quasar": {
            "optional": true
        },
        "vue-router": {
            "optional": true
        }
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@quasar/vite-plugin": "^1.12.0",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^30.0.1",
        "pinia": "^3.0.0",
        "quasar": "^2.24.0",
        "sass": "^1.101.3",
        "tsup": "^8.0.0",
        "typescript": "^6.0.0",
        "vite": "^7.3.6",
        "vitest": "^4.1.10",
        "vue": "^3.5.0",
        "vue-router": "^5.0.0",
        "vue-tsc": "^3.3.3"
    },
    "license": "Apache-2.0",
    "author": "Taci Uelker",
    "homepage": "https://github.com/uelker70/saasicat",
    "repository": {
        "type": "git",
        "url": "https://github.com/uelker70/saasicat.git",
        "directory": "packages/saas-platform-ui-vue"
    },
    "bugs": {
        "url": "https://github.com/uelker70/saasicat/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
