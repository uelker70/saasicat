{
    "name": "@saasicat/ui-vue-tenant",
    "version": "1.0.0-rc.0",
    "description": "Vue 3 components for the tenant-facing side of SaaSiCat: the plan section, the plan-change wizard, the onboarding configurator and the bundle store. Rendered inside the customer's own application, under the customer's branding and in the customer's language.",
    "type": "module",
    "exports": {
        "./*.vue": "./src/*.vue",
        "./*.js": "./src/*.ts",
        "./package.json": "./package.json"
    },
    "files": [
        "src"
    ],
    "scripts": {
        "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.tests.json",
        "test:component": "vitest run --config vitest.config.ts",
        "test:shipped-source": "node ../ui-vue/scripts/check-shipped-source.mjs"
    },
    "peerDependencies": {
        "@saasicat/types": "workspace:^",
        "@saasicat/ui-vue": "workspace:^",
        "quasar": "^2.22.0",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@saasicat/types": "workspace:*",
        "@saasicat/ui-vue": "workspace:*",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^30.0.1",
        "quasar": "^2.22.0",
        "vitest": "^4.1.10",
        "vue": "^3.5.0",
        "vue-tsc": "^3.2.0"
    },
    "keywords": [
        "saasicat",
        "vue",
        "quasar",
        "tenant",
        "self-service"
    ],
    "license": "PolyForm-Shield-1.0.0",
    "author": "Taci Uelker",
    "homepage": "https://github.com/uelker70/saasicat",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/uelker70/saasicat.git",
        "directory": "packages/ui-vue-tenant"
    },
    "publishConfig": {
        "access": "public"
    }
}
