// Which files are linted. The rules themselves are in `.markdownlint.jsonc`,
// so a subdirectory can extend them instead of repeating them.
{
    "globs": [
        "**/*.md",
        "!**/node_modules/**",
        "!**/dist/**",
        // Generated by Changesets from the changeset prose at release time.
        // Fixing them by hand would last until the next release.
        "!**/CHANGELOG.md",
        // Generated by `scripts/gen-docs` from the sources, and a repo test
        // compares them against it. Same reason as above: a hand edit here
        // lasts until the next run, and Prettier already governs their width.
        "!docs/reference/**",
        // Generated by `scripts/requirements` from `requirements/`, with the
        // same guard. The sources themselves are linted; this is their output.
        "!docs/requirements.md",
        // A coding session puts its git worktrees here, so a second checkout of
        // the whole repository sits inside this one and every tool that walks
        // the tree reports the other branch's files as ours. `.gitignore` says
        // so and names the two tools that had to repeat the entry; this is the
        // third, because markdownlint does not read `.gitignore` either.
        "!.claude/**",
        // The internal planning folder: German, gitignored, never published.
        "!handoff/**",
    ],
}
