{
    "path": ["packages", "examples"],
    "ignore": [
        "**/node_modules/**",
        "**/dist/**",
        "**/coverage/**",
        "**/.integration-tmp/**",
        "**/CHANGELOG.md",
        "**/*.snap",
        "**/tests/**",
        "**/tests-component/**",
        "**/test/**",
        "**/*.test.*",
        "**/*.spec.*"
    ],
    "format": ["typescript", "javascript", "vue", "scss", "css", "markup"],
    "minTokens": 50,
    "maxLines": 50000,
    "threshold": 1.85,
    "reporters": ["console", "json"],
    "output": "./.jscpd-report/sources",
    "absolute": false,
    "gitignore": true
}
