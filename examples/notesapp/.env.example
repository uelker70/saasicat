# ── Pick ONE of the two setups in the README, and do not mix them. ──────────
#
# 1. Disposable database, for `pnpm start` outside containers:
#      docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=test postgres:16
#    That container's user, password and database are `postgres`/`test`/
#    `postgres`, which is what the line below says.
DATABASE_URL=postgresql://postgres:test@localhost:5432/postgres
#
# 2. The compose stack (`docker compose up`): the backend gets its own
#    DATABASE_URL from docker-compose.yml and ignores this one. Set this
#    instead when you run `db:push`/`db:seed` from the host against that
#    stack — all three values are `notesapp` there, and the port is
#    DB_HOST_PORT below, NOT 5432:
#      DATABASE_URL=postgresql://notesapp:notesapp@localhost:5432/notesapp
#
# Taking the port from setup 2 and the credentials from setup 1 is the one
# combination that looks plausible and fails with "Authentication failed
# against database server".

# Enables the first-run SuperAdmin setup wizard endpoints.
SETUP_TOKEN=demo-setup-token

# Seals the SuperAdmin's TOTP secret before it is stored: 32 bytes, base64.
# The backend does not start without it. This one is a public demo key —
# generate your own for anything that is not a demo:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Changing the key later means every SuperAdmin enrols their second factor again.
SECRET_SEALER_KEY=ZGVtby1rZXktZm9yLXRoZS1ub3Rlc2FwcC1zdGFjayE=

# Host ports the compose stack publishes (docker-compose.yml). Change one when
# the default is already taken on your machine; the ports inside the containers
# stay fixed, so nothing else needs adjusting.
#DB_HOST_PORT=5432        # Postgres
#BACKEND_HOST_PORT=3000   # API
#ADMIN_HOST_PORT=9000     # SuperAdmin UI
#WEB_HOST_PORT=8080       # tenant-facing web UI
