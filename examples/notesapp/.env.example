# Disposable local database — e.g.:
#   docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=test postgres:16
DATABASE_URL=postgresql://postgres:test@localhost:5432/postgres

# Enables the first-run SuperAdmin setup wizard endpoints.
SETUP_TOKEN=demo-setup-token

# Host ports the compose stack publishes (docker-compose.yml). Change one when
# the default is already taken on your machine; the ports inside the containers
# stay fixed, so nothing else needs adjusting.
#DB_HOST_PORT=5432        # Postgres
#BACKEND_HOST_PORT=3000   # API
#ADMIN_HOST_PORT=9000     # SuperAdmin UI
#WEB_HOST_PORT=8080       # tenant-facing web UI
