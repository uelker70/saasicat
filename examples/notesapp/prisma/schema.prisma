// NotesApp example — Prisma schema.
//
// App-owned tables (Tenant, User, Note) plus the full V3 platform surface
// from the canonical @saasicat/spec prisma-fragments:
//   01 (Subscription + checkout offer)
//   02 (PromoCode + redemption + validation log)
//   03 (Plan + PlanVersion)
//   04 (AuditLog)
//   05 (Bundle versioning)
//   06 (catalog entries + marketing)
//   07 (Promotion)
//   08 (SubscriptionContract + ContractLineItem)
//   10 (SuperAdmin + MFA)
//   12 (the applied settings and their changes)
//   13 (Subscriber, its tenants and corrections)
//   14 (the subscriber's payment method and the gateway events)
//   15 (the subscriber's account: one charge per contract line and period)
//   16 (maintenance windows)
//   17 (what each subscriber was told)
//   20 (the invoices issued from those charges, and their number range)
//   22 (each invoice's document, archived and never changed)
//   23 (the attempts to collect an invoice through its payment gateway)
//   24 (what the collections brought: payments, credits, refunds, reversals)
//   26 (the confirmation each contract is due, and its archived file)
//   27 (a returning customer's subscriber joined into the one it had)
// The platform blocks below are hand-maintained copies of the fragments, with
// the consumer relations to Tenant/User enabled. `schema apply` seeds them —
// enums and models — into a fresh schema, but does not update blocks that
// already exist — verify with `pnpm exec saasicat schema check` after a package
// upgrade, which reports every field this schema is missing.
// PostgreSQL constraints the Prisma DSL cannot express are shipped, not copied:
// docker-entrypoint.sh applies @saasicat/spec/sql/constraints.postgres.sql
// after db push. A project using Prisma Migrate instead gets the same file
// appended to its migration by `saasicat schema migrate`.

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// App tables — everything below is ordinary application modeling.
// -----------------------------------------------------------------------------

model Tenant {
    id        String   @id @default(uuid())
    slug      String   @unique
    name      String
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    users User[]
    notes Note[]

    subscription          Subscription?
    promoCodeRedemptions  PromoCodeRedemption[]

    @@map("tenants")
}

model User {
    id        String   @id @default(uuid())
    tenantId  String
    email     String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@index([tenantId])
    @@map("users")
}

model Note {
    id        String   @id @default(uuid())
    tenantId  String
    title     String
    body      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@index([tenantId, createdAt])
    @@map("notes")
}

// =============================================================================
// SaaS-Platform Prisma fragment: audit log
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// Generic audit log for tenant- and admin-side actions. Consumers
// can share the log or keep their own parallel logs — the
// `@saasicat/nest` package writes into this schema.
//
// `action` must follow SCREAMING_SNAKE_CASE (see
// `schemas/audit-event.schema.json` action pattern). Consumer-specific
// actions are allowed; platform actions are cataloged in the `AuditActionDef`
// list of the manifest contributions.

model AuditLog {
    id        String  @id @default(uuid())
    tenantId  String? // the tenant it concerns; null for none or the commercial record
    userId    String? // actor — null for system cron or pre-auth actions
    entity    String // e.g. "Subscription", "PromoCode", "PlanVersion"
    entityId  String
    action    String // SCREAMING_SNAKE_CASE; e.g. "PROMO_CODE_REDEEM"
    changes   Json? // { field: { old: …, new: … } }
    // Origin marker 'web:<email>:<sessionId>' | 'cli:<email>:<host>' |
    // 'job:platform:<job>' — see
    // audit-event.schema.json `actorTag`. Queryable with a trailing wildcard
    // ('cli:*') via AuditQueryPort.
    actorTag  String?
    ipAddress String?
    userAgent String?

    createdAt DateTime @default(now())

    // Relations — the consumer must define `Tenant` and `User` and
    // enable relations. Userless system actions leave userId null.
    // tenant Tenant? @relation(fields: [tenantId], references: [id])
    // user   User?   @relation("AuditLogUser", fields: [userId], references: [id])

    @@index([tenantId, entity, entityId])
    @@index([tenantId, createdAt])
    @@index([entity, action, createdAt])
    @@index([actorTag, createdAt])
    @@map("audit_logs")
}

// =============================================================================
// SaaS-Platform Prisma fragment: catalog entries (discovery review + marketing)
// =============================================================================
//
// REFERENCE SNIPPET — see 03-plan-versions.prisma for conventions.
//
// Three tables:
//   - CapabilityCatalogEntry  — SuperAdmin review status per code-declared
//                               capability (discovery projection)
//   - FeatureCatalogEntry     — ditto for features + marketing fields
//   - MarketingProjection     — marketing texts/pricing/highlights per
//                               plan/bundle version (locale pivot)
//
// Approval lifecycle (#20, feature-/quota-centric):
//   pending → approved (↔ revoke) · outdated (drift) · obsolete
// Approval happens per FEATURE/QUOTA — capabilities now only carry the
// read-only code status (active | experimental | deprecated | retired).
//
// Backfill when migrating from the old vocabulary (per consumer DB):
//   feature_/quota_catalog_entries.discoveryStatus:
//     discovered→pending · accepted→approved · active→approved ·
//     ignored→pending · deprecated→outdated · retired→obsolete
//   capability_catalog_entries: rename column discoveryStatus → codeStatus,
//     values: deprecated→deprecated · retired→retired · everything else→active
//
// Global catalog tables (no tenantId, no RLS). Write access only via the
// SUPER_ADMIN guard in the AdminController.

// -----------------------------------------------------------------------------
// CapabilityCatalogEntry — read-only code fact per code capability (#20).
//
// Every capability declared via @ImplementsCapability(...) appears here after
// the first discovery scan with its decorator status (`codeStatus`). The sync
// always overwrites the code status; it sets `retired` when the capability is
// missing from the new snapshot. There is no longer a business approval at the
// capability level — that lives on the feature/quota.
//
// `featureKey` and `bundleKey` are the aggregation wrappers declared in the
// decorator — denormalized for fast lookup in the discovery UI; the binding
// source, however, remains the code annotation, not this DB entry.
// -----------------------------------------------------------------------------

model CapabilityCatalogEntry {
    id            String  @id @default(uuid())
    capabilityKey String // 'invoice.create' | 'member.archive' | …
    label         String
    description   String?

    // Aggregation wrappers from the decorator (denormalized).
    featureKey String?
    bundleKey  String?

    // Read-only code status from the decorator (#20); 'retired' = removed from code.
    codeStatus String @default("active") // active | experimental | deprecated | retired

    // Code owner tag for audit (e.g. 'accounting', 'membership').
    owner String?

    // Implementation kind (matches decorator.kind):
    // 'endpoint' | 'service' | 'job' | 'event'
    kind String

    // When deprecated: target version + planned removal.
    replacementKey   String?
    deprecatedAt     DateTime?
    removalPlannedAt DateTime?
    reason           String?

    // Locale translations: { "en": { label, description }, "tr": {…} }.
    // The default locale is deliberately absent — fallback in the UI. SPEC_V2 §6.3.
    i18n Json @default("{}")

    sortOrder Int @default(0)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@unique([capabilityKey])
    @@index([codeStatus])
    @@index([featureKey])
    @@map("capability_catalog_entries")
}

// -----------------------------------------------------------------------------
// FeatureCatalogEntry — SuperAdmin review status + marketing master data per
// feature. Aggregation from the capabilities that declare `feature: 'XYZ'`
// in the decorator.
//
// Marketing texts (`marketingLabel` / `marketingDescription`) are the short
// slot for the sidebar/comparison matrix; the *long* locale-specific texts
// live in MarketingProjection (separate table, locale pivot).
//
// `plannedOnly = true` lets the SuperAdmin add a feature that does not yet
// exist in code to a plan (e.g. for roadmap marketing). The blocking strict-
// mode check (SPEC_V2 §8.1) rejects `plannedOnly` features at plan publish —
// they may only appear in internal drafts or warn-only builds.
// -----------------------------------------------------------------------------

model FeatureCatalogEntry {
    id          String  @id @default(uuid())
    featureKey  String // 'INVOICE_MANAGEMENT' | 'MEMBER_LIST' | …
    label       String
    description String?

    // Marketing short form (for sidebar/comparison). Detailed texts
    // per locale → MarketingProjection.
    marketingLabel       String?
    marketingDescription String?
    icon                 String?

    // Tier hint for comparison-matrix sorting.
    // Convention: 'CORE' < 'ADVANCED' < 'PRO' < 'ENTERPRISE'
    tier String?

    // True = base feature, always included (not bookable per plan).
    core Boolean @default(false)

    // Code-discovered feature dependencies (#35) and succession (#39) —
    // see FeatureCatalogEntryRow in @saasicat/core.
    requires     String[]
    replaces     String[]
    successorKey String?

    // Approval lifecycle (#20): pending | approved | outdated | obsolete.
    discoveryStatus String @default("pending")

    // Approval signature (#20): freezes the capability set at approval time
    // ('capabilityKey@codeStatus', sorted, '|'-separated). The auto-sync
    // compares against the current snapshot → on drift approved → outdated.
    approvedAt        DateTime?
    approvedBy        String?
    approvedSignature String?

    // True = feature is planned in the SuperAdmin but not yet implemented in
    // code. Blocking strict mode rejects plan publish with plannedOnly
    // features.
    plannedOnly Boolean @default(false)

    // Locale translations { "en": { label, description }, … }. SPEC_V2 §6.3.
    i18n Json @default("{}")

    sortOrder Int @default(0)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@unique([featureKey])
    @@index([discoveryStatus])
    @@index([plannedOnly])
    @@map("feature_catalog_entries")
}

// -----------------------------------------------------------------------------
// QuotaCatalogEntry — SuperAdmin review status per code-declared quota
// (`@DefinesQuota`). `usageProvider` is the class that provides the quota;
// `null` = referenced (`@EnforceQuota`) but provided by no class. A hard quota
// without `usageProvider` is not deployable — `yada app preflight` blocks it
// (SPEC_V2 §6.3 + §8.3).
// -----------------------------------------------------------------------------

model QuotaCatalogEntry {
    id          String  @id @default(uuid())
    quotaKey    String // 'invoicesPerMonth' | 'members' | 'storageGb' | …
    label       String
    description String?

    unit       String // Display unit: 'members' | 'GB' | '/month' | …
    featureKey String? // Aggregation wrapper from the decorator (denormalized)

    // Class that declares the quota via @DefinesQuota (= UsageProvider).
    usageProvider   String?
    enforcementMode String  @default("soft") // hard | soft

    // Approval lifecycle (#20): pending | approved | outdated | obsolete.
    discoveryStatus String @default("pending")

    // Predecessor quotaKeys this quota replaces + a successor pointer (#39),
    // analogous to FeatureCatalogEntry. The discovery sync overwrites both.
    replaces     String[]
    successorKey String?

    // Approval signature (#20): code-derived quota facts at approval time
    // ('unit|enforcementMode|usageProvider|featureKey'); on drift approved →
    // outdated.
    approvedAt        DateTime?
    approvedBy        String?
    approvedSignature String?

    // Locale translations { "en": { label, unit, description }, … }.
    i18n Json @default("{}")

    sortOrder Int @default(0)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@unique([quotaKey])
    @@index([discoveryStatus])
    @@map("quota_catalog_entries")
}

// -----------------------------------------------------------------------------
// MarketingProjection — locale-specific marketing texts per
// plan/bundle version.
//
// Read and projected by the public catalog controller
// (`GET /public/catalog?locale=de`). Only versions with status `marketed` and
// a matching MarketingProjection entry appear in the public list.
//
// Polymorphic reference via (`targetType`, `targetVersionId`) instead of three
// separate FK columns — deliberate, because a cascade delete for three models
// would be complicated and uniqueness via (targetType, targetVersionId,
// locale) is sufficient. App logic checks existence on read.
//
// MVP: locale `de` is mandatory; further locales (e.g. `en`) are allowed as
// schema preparation but not enforced (see SPEC_V2 V2-Q1).
// -----------------------------------------------------------------------------

model MarketingProjection {
    id String @id @default(uuid())

    // Polymorphic reference to a versioned entity.
    targetType      String // 'PLAN' | 'BUNDLE'
    targetVersionId String // PlanVersion.id | BundleVersion.id

    locale String @default("de") // ISO-639-1, optionally with a region suffix ('de', 'en', 'de-AT')

    displayLabel String
    description  String

    // Visibility in the public catalog — false = projection exists but does
    // not appear on the pricing page.
    visible Boolean @default(true)

    // Optional badge at the top of the card ('Popular', 'New'). '' = no badge.
    badge String @default("")

    // Top features for the public catalog card: [{ label, strong }].
    // Order is the display order.
    topFeatures Json @default("[]") // { label: string; strong: string }[]

    // Free trial period — controls the auto-generated CTA text.
    trialEnabled Boolean @default(false)
    trialDays    Int     @default(30)

    // Optional formatted pricing tag (e.g. "EUR 9.90 / month" or "on request").
    // If null: pricing is formatted automatically from PlanVersion.monthlyNet
    // etc. at public-catalog render time.
    priceTag String?

    // Overrides the auto-generated call-to-action text.
    ctaLabel String?

    // Sort order in the public list (DESC). Higher values first.
    priority Int @default(0)

    // The recommended plan: a star, or a featured card, in the UI.
    highlight Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([targetType, targetVersionId, locale])
    @@index([targetType, locale, priority])
    @@map("marketing_projections")
}

// -----------------------------------------------------------------------------
// MarketingSettings — installation-wide, runtime-editable marketing config.
// At most one row — a CHECK in the platform constraints holds it, not the
// default on `id`. Currently one field:
// `activeLocales` — the subset of the `availableLocales` pool activated in the
// marketing catalog (the pool comes from the app config, SPEC_V2 §6.5).
// If the row is missing, the full pool counts as active.
// -----------------------------------------------------------------------------

model MarketingSettings {
    id String @id @default("marketing-settings")

    activeLocales Json @default("[]") // string[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("marketing_settings")
}

// =============================================================================
// SaaS-Platform Prisma fragment: SuperAdmin identity + MFA
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// Platform-owned SuperAdmin accounts, separate from the consumer's tenant
// user model. The `@saasicat/adapter-prisma` adapters
// (`PrismaSuperAdminBootstrapAdapter`, `PrismaMfaAdapter`) write into these
// tables; the consumer's admin auth reads them for SuperAdmin login.
//
// Apps that keep SuperAdmins inside their own user table skip this fragment
// and implement `SuperAdminProvisioningPort` / `MfaPort` themselves.
//
// Global tables (no tenantId, no RLS).

model SuperAdminUser {
    id           String  @id @default(uuid())
    email        String  @unique // stored lowercase; adapters normalize
    passwordHash String
    firstName    String?
    lastName     String?

    // Constant today ('SUPER_ADMIN'); column exists so later platform roles
    // do not need a migration.
    platformRole String  @default("SUPER_ADMIN")
    isActive     Boolean @default(true)

    lastLoginAt DateTime?
    deletedAt   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive, deletedAt])
    @@map("super_admin_users")
}

model SuperAdminMfa {
    // Admin user ID — deliberately NO hard FK: `MfaPort` also serves apps
    // that keep their admin identities in their own user table. Apps whose
    // admins live exclusively in `super_admin_users` may add the relation:
    // user SuperAdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String    @id
    secret    String? // TOTP secret, sealed by the installation's SecretSealer; null after reset
    enabledAt DateTime? // set when a secret is stored, null after reset

    updatedAt DateTime @updatedAt

    @@map("super_admin_mfa")
}

// =============================================================================
// SaaS-Platform Prisma fragment: Subscription + Payment method
// =============================================================================
//
// REFERENCE SNIPPET — not a standalone schema. Consumers copy
// models into their `schema.prisma` and adapt the FK relations to their own
// `Tenant`/`User` models.
//
// Conventions:
//   - Plan/feature keys as `String` — source of truth is the
//     consumer's `config/plans.yaml`, validated via
//     `@saasicat/spec/schemas/plan-catalog.schema.json`.
//     Whoever prefers Postgres enums can declare an enum locally and
//     cast the field via `@db.<EnumName>` — not a platform requirement.
//   - FK columns to consumer models are declared as `String` with a
//     commented-out example relation. The consumer adds the `@relation`
//     with their own `Tenant`/`User` model.
//   - `@@map` names are the canonical table names — please do not
//     change them, otherwise the shared migration path breaks in P1.5+.
//
// Accompanying fragments:
//   - 03-plan-versions.prisma  (PlanVersion — referenced here)
//   - 02-promo-code.prisma     (PromoCodeRedemption has 1:1 to Subscription)

// -----------------------------------------------------------------------------
// Universal enums — project-independent, identical in every consumer.
// -----------------------------------------------------------------------------

enum BillingCycle {
    MONTHLY
    YEARLY
}

enum SubscriptionStatus {
    TRIAL
    ACTIVE
    PAST_DUE
    CANCELED
    PENDING_SALES
}

// -----------------------------------------------------------------------------
// Subscription — one per Tenant. Binds to PlanVersion (see 03-plan-versions).
// -----------------------------------------------------------------------------

model Subscription {
    id       String @id @default(uuid())
    tenantId String @unique
    // Plan key from plans.yaml (`plans[].id`). Whoever wants an enum: declare locally.
    plan         String
    billingCycle BillingCycle       @default(YEARLY)
    status       SubscriptionStatus @default(TRIAL)

    trialEndsAt DateTime?
    startedAt   DateTime?
    canceledAt          DateTime?
    canceledEffectiveAt DateTime?

    // Renewal period (maintained by PlanVersionRenewalService).
    currentPeriodStart DateTime?
    currentPeriodEnd   DateTime?

    minimumTermUntil DateTime?

    // Day of the month this subscription is billed on, 1–31. Written when a
    // period window opens; never by a renewal.
    billingAnchorDay Int?

    // Plan versioning — binds to a published PlanVersion, and keeps it across
    // renewals: a newer version reaches the subscription as an offer, and a
    // switch to it is a change like any other (`pendingPlan` below).
    planVersionId String

    // Trial / scheduled plan changes
    trialEntitlementPlan String? // Default entitlement during TRIAL
    postTrialPlan        String? // Target package after trial
    pendingPlan          String? // Downgrade/change at period end
    pendingBillingCycle  BillingCycle?
    pendingEffectiveAt   DateTime?
    // The version of `pendingPlan` the change was quoted at, bound when it
    // comes due; null where the plan stays or nothing reads versions.
    pendingChangeVersionId String?
    // What the subscriber agreed to when they scheduled the change: the
    // version of the operator's terms and the days of notice config/saas.yaml
    // named then, and when. The contract the change ends in records them,
    // unless a later agreement of theirs is in force by then. Null where
    // nothing is scheduled.
    pendingTermsVersion           String?
    pendingCancellationNoticeDays Int?
    pendingAgreedAt               DateTime?

    // Special contract / pilot — audit (who/when) lives in the AuditLog.
    customMonthlyNet Decimal?  @db.Decimal(10, 2)
    customLimits     Json? // CustomLimits (@saasicat/core): { quotas?: { <quotaKey>: number }, features?: string[] }
    customNote       String?
    isPilot          Boolean   @default(false)
    pilotEndsAt      DateTime?
    pilotNote        String?

    // Package consistency (METAMODELL §17a) — references the CheckoutOffer
    // from which the Subscription originated; `packageSnapshot` is the offer
    // frozen at closing time (plan + promo + bundles +
    // quotas + price breakdown). Price-fixed billing
    // basis; null for legacy/direct subscriptions without an onboarding offer.
    checkoutOfferId String?
    packageSnapshot Json?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations.
    tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
    promoRedemption     PromoCodeRedemption? // see 02-promo-code.prisma
    planVersion         PlanVersion                 @relation("SubscriptionPlanVersion", fields: [planVersionId], references: [id])
    pendingChangeVersion PlanVersion?               @relation("SubscriptionPendingChangeVersion", fields: [pendingChangeVersionId], references: [id], onDelete: Restrict)
    // Standalone add-on bookings (see the SubscriptionBundle model below).
    bundles             SubscriptionBundle[]

    @@index([tenantId])
    @@index([planVersionId])
    @@index([pendingChangeVersionId])
    @@index([currentPeriodEnd])
    @@map("subscriptions")
}

// -----------------------------------------------------------------------------
// CheckoutOffer — immutable package snapshot from the website through to the
// Subscription (METAMODELL §17a).
//
// On a package click on the pricing page, `POST /public/checkout-offer` creates
// an offer; its `id` travels as `?offer=<id>` into onboarding. There
// the tenant customizes it (bundles/quotas) — `PATCH` writes
// the delta back. On subscription creation the offer becomes `consumed` and
// is frozen as `Subscription.packageSnapshot`.
//
// Global table (no RLS) — the offer is created before the tenant is created.
// -----------------------------------------------------------------------------

model CheckoutOffer {
    id String @id @default(uuid())

    planKey       String
    planVersionId String?
    billingCycle  String // monthly | yearly

    promotionId String?
    promoCode   String?

    bundles Json @default("[]") // string[]
    bundleVersionIds Json @default("[]") // concrete BundleVersion IDs (V3)

    priceBreakdown     Json
    lineItems          Json @default("[]") // ContractLineItem snapshot shape before contract conclusion
    promotionSnapshots Json @default("[]")
    promoCodeSnapshot  Json?
    locale             String @default("de")
    validUntil         DateTime?

    status     String    @default("open") // open | consumed | expired
    consumedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([status])
    @@map("checkout_offers")
}

// =============================================================================
// SaaS-Platform Prisma fragment: promo codes
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// Accompanying fragments:
//   - 01-subscription.prisma  (PromoCodeRedemption is 1:1 with Subscription)

// -----------------------------------------------------------------------------
// Universal enums.
// -----------------------------------------------------------------------------

enum PromoCodeValueType {
    PERCENT
    ABSOLUTE
}

enum PromoCodeDurationType {
    ONCE
    MONTHS
    BILLING_CYCLES
}

enum PromoCodeStatus {
    ACTIVE
    PAUSED
    EXHAUSTED
    EXPIRED
}

enum PromoCodeRedemptionStatus {
    ACTIVE
    REVERSED
    EXPIRED
}

// -----------------------------------------------------------------------------
// PromoCode — marketing discount code for onboarding checkout.
// -----------------------------------------------------------------------------

model PromoCode {
    id        String             @id @default(uuid())
    code      String             @unique // case-insensitive, stored in UPPER
    valueType PromoCodeValueType
    value     Decimal            @db.Decimal(8, 2) // % for PERCENT, EUR for ABSOLUTE

    // Duration
    durationType  PromoCodeDurationType @default(ONCE)
    durationValue Int? // null for ONCE; 1–24 for MONTHS / BILLING_CYCLES

    validFrom      DateTime?
    validUntil     DateTime?
    maxRedemptions Int? // null = unlimited

    // Availability-relevant — counts only redemptions with status=ACTIVE.
    // Incremented atomically in the redeem() path, decremented on trial cancellation.
    redemptionsCount Int @default(0)
    // Slots kept for checkouts that have started and not concluded (see
    // PromoCodeHold). A code has a free slot while redemptionsCount + heldCount
    // stays below maxRedemptions; the status says nothing about holds.
    heldCount        Int @default(0)

    // Plan whitelist as String[] — values are plan IDs from plans.yaml.
    // Consumers using a Postgres enum can cast the field locally.
    appliesToPlans   String[] // empty = all plans; otherwise whitelist
    appliesToBilling BillingCycle? // null = both; otherwise only MONTHLY or YEARLY

    // Anti-abuse
    firstTimeCustomersOnly Boolean  @default(true)
    minimumPlanAmountGross Decimal? @db.Decimal(10, 2)
    allowZeroInvoice       Boolean  @default(false)

    status      PromoCodeStatus @default(ACTIVE)
    description String?
    campaignTag String?

    // Accounting — SKR account no. (e.g. "4736"); if null, the
    // consumer falls back to the system default (configurable in the consumer).
    revenueDeductionAccount String?

    createdById String // SUPER_ADMIN user ID (consumer FK, see header)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime? // soft delete; never hard-delete for audit reasons

    redemptions    PromoCodeRedemption[]
    validationLogs PromoCodeValidationLog[]
    holds          PromoCodeHold[]

    @@index([status, validFrom, validUntil])
    @@index([campaignTag])
    @@map("promo_codes")
}

// -----------------------------------------------------------------------------
// PromoCodeRedemption — a subscription can have only one active code.
// -----------------------------------------------------------------------------

model PromoCodeRedemption {
    id             String @id @default(uuid())
    promoCodeId    String
    subscriptionId String @unique
    tenantId       String

    // Snapshot of the code rule at redemption time.
    appliedValueType     PromoCodeValueType
    appliedValue         Decimal               @db.Decimal(8, 2)
    appliedDurationType  PromoCodeDurationType
    appliedDurationValue Int?

    // Validity window — endsAt null for ONCE, otherwise computed from the snapshot.
    startsAt DateTime
    endsAt   DateTime?

    status     PromoCodeRedemptionStatus @default(ACTIVE)
    redeemedAt DateTime                  @default(now())
    reversedAt DateTime?

    promoCode    PromoCode    @relation(fields: [promoCodeId], references: [id])
    subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
    tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

    @@index([tenantId])
    @@index([promoCodeId, status])
    @@index([startsAt, endsAt])
    @@map("promo_code_redemptions")
}

// -----------------------------------------------------------------------------
// PromoCodeHold — a slot of a code kept for a checkout from its start, so that
// a customer who reaches the payment form keeps the code they started with.
// For a sign-up, `expiresAt` is the last moment a confirmation of its payment
// form can arrive, not the checkout's lifetime. It counts in
// PromoCode.heldCount, and it ends in one of three ways, each deleting the row
// and giving the count back: the conclusion turns it into the redemption, the
// checkout offer's code changes, or `expiresAt` passes. It is a reservation
// rather than a record — what a customer was granted is the
// PromoCodeRedemption.
// -----------------------------------------------------------------------------

model PromoCodeHold {
    id          String @id @default(uuid())
    promoCodeId String
    // Not a foreign key: an offer deleted while it holds a slot leaves the hold
    // to expire, which gives the slot back. A cascade would delete the row and
    // leave heldCount counting it.
    checkoutOfferId String    @unique
    expiresAt       DateTime
    // The id of the transaction a conclusion runs on (`txid_current()`), set on
    // that transaction and gone before it commits: the redemption running on
    // the same transaction finds its slot by it, and no other one can.
    handedOverTx    BigInt?
    createdAt       DateTime  @default(now())

    promoCode PromoCode @relation(fields: [promoCodeId], references: [id])

    @@index([promoCodeId, expiresAt])
    @@index([expiresAt])
    @@map("promo_code_holds")
}

// -----------------------------------------------------------------------------
// PromoCodeValidationLog — audit trail of all validation attempts
// (including failed NOT_FOUND/EXPIRED), for anti-abuse analysis.
// -----------------------------------------------------------------------------

model PromoCodeValidationLog {
    id          String   @id @default(uuid())
    promoCodeId String? // null for NOT_FOUND attempts
    codeAttempt String // input in UPPER (retained even for NOT_FOUND)
    ipHash      String? // hash of the IP, no plaintext (data protection)
    sessionId   String? // onboarding session / CSRF token
    result      String // "VALID" | "EXPIRED" | "EXHAUSTED" | "NOT_FOUND" | "PLAN_MISMATCH" | …
    createdAt   DateTime @default(now())

    promoCode PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

    @@index([codeAttempt, createdAt])
    @@index([ipHash, createdAt])
    @@index([sessionId, createdAt])
    @@map("promo_code_validation_logs")
}

// =============================================================================
// SaaS platform Prisma fragment: plan versioning
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// Global catalog tables (no tenantId, no RLS). Write access only via the
// SUPER_ADMIN guard in the AdminController of the `@saasicat/nest`
// package.
//
// Per identity key (planId):
//   - at most 1 draft (publishedAt IS NULL) — constraint via a partial unique
//     index in the migration (the Prisma schema cannot express partial unique:
//     add it in the SQL migration as
//     `CREATE UNIQUE INDEX … WHERE published_at IS NULL`).
//   - multiple published versions, monotonically incrementing `version`.
//   - `supersededAt` marks "no longer actively marketed"; the version
//     remains billing-valid for existing subscriptions (contractual plan guarantee).

// -----------------------------------------------------------------------------
// Plan — root identity of a plan (SPEC_V2 §11.1 M6).
// `planKey` is the business plan identity (STARTER / STANDARD / PROFESSIONAL),
// unique for the installation. PlanVersion.planId points **softly** to
// `Plan.planKey` (no DB FK — the binding is enforced via service logic in M6
// so that the greenfield cutover can run without a destructive schema
// migration).
//
// Soft-delete via `deletedAt`. A deleted plan root hides its
// PlanVersions in the UI, but keeps them effective for existing subscriptions
// (contract protection P1) — analogous to Bundle.
// -----------------------------------------------------------------------------

model Plan {
    id          String  @id @default(uuid())
    planKey     String
    label       String
    description String?
    icon        String?
    sortOrder   Int     @default(0)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@unique([planKey])
    @@index([deletedAt])
    @@map("plans")
}

// -----------------------------------------------------------------------------
// PlanVersion — exactly one lineage per `planId` (= plan key from plans.yaml).
// -----------------------------------------------------------------------------

model PlanVersion {
    id            String  @id @default(uuid())
    planId        String // plan key from plans.yaml (`plans[].id`)
    version       Int
    baseVersionId String? // predecessor the draft diffs against (nullable for v1)

    // Snapshot of the plan definition at the time of publishing.
    // `features` is the published feature set as FeatureKey[].
    // `quotas` is a free-form JSON object; concrete quota keys come from
    // plans.yaml (`quotaKeys` pattern). Example:
    //   { "users": 5, "vehicles": 100, "storageGb": 50 }
    features Json
    quotas   Json

    monthlyNet Decimal @db.Decimal(10, 2)
    yearlyNet  Decimal @db.Decimal(10, 2) // net total amount per year for the YEARLY cycle
    marketed   Boolean @default(true)

    publishedAt      DateTime?
    supersededAt     DateTime?
    publishedChanges Json? // VersionChange[] — see @saasicat/core
    changeNote       String
    nonRegressive    Boolean @default(true)

    // Booking window for new subscriptions. Nullable for backwards-compatible
    // legacy rows; `endsAt` is an optional precise administrative termination.
    validFrom  DateTime?
    validUntil DateTime?
    endsAt     DateTime?

    createdByUserId   String?
    publishedByUserId String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    baseVersion          PlanVersion?   @relation("PlanVersionLineage", fields: [baseVersionId], references: [id])
    derivedVersions      PlanVersion[]  @relation("PlanVersionLineage")
    subscriptionsCurrent Subscription[] @relation("SubscriptionPlanVersion")
    subscriptionsPendingChange Subscription[] @relation("SubscriptionPendingChangeVersion")

    @@unique([planId, version])
    @@index([planId, supersededAt])
    @@index([planId, publishedAt])
    @@index([planId, validFrom])
    @@map("plan_versions")
}

// =============================================================================
// SaaS platform Prisma fragment: Bundle (plan catalog extension)
// =============================================================================
//
// REFERENCE SNIPPET — see 03-plan-versions.prisma for versioning conventions.
//
// Global catalog tables (no tenantId, no RLS). Write access only via the
// SUPER_ADMIN guard in the AdminController of the `@saasicat/nest`
// package. One installation serves one application, so `bundleKey` is the
// whole identity.
//
// Versioning pattern identical to PlanVersion:
//   - at most 1 draft (publishedAt IS NULL) per identity — constraint via a
//     partial unique index in the migration.
//   - multiple published versions, monotonically incremental `version`.
//   - `supersededAt` marks "no longer actively marketed"; existing bookings
//     stay on the committed version (contractual plan guarantee P1).
//
// -----------------------------------------------------------------------------
// Bundle — reusable component of features + quotas + pricing.
//
// Root entity without content — the purchasable fields (features, quotas,
// pricing) live on BundleVersion.
// -----------------------------------------------------------------------------

model Bundle {
    id          String   @id @default(uuid())
    bundleKey   String // SCREAMING_SNAKE_CASE, e.g. 'SPORT', 'ACCOUNTING', 'EVERSEND_PEPPOL'
    label       String
    description String?
    icon        String?
    sortOrder   Int      @default(0)

    // Locale translations { "en": { label, description }, … }. SPEC_V2 §6.4.
    i18n Json @default("{}")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    versions BundleVersion[]

    @@unique([bundleKey])
    @@index([deletedAt])
    @@map("bundles")
}

// -----------------------------------------------------------------------------
// BundleVersion — versioned composition (features, quotas, pricing).
// `features` is FeatureKey[] (references Discovery / FeatureCatalogEntry).
// `quotas` is Record<QuotaKey, number>; -1 = unlimited; missing key = 0.
// `compatibility` is BundleCompatibility (`planIds?` whitelist). Empty =
// usable with every plan. `pricingOverrides` is an array of
// BundlePricingOverride values for plan-dependent prices.
// -----------------------------------------------------------------------------

model BundleVersion {
    id            String  @id @default(uuid())
    bundleId      String
    version       Int
    baseVersionId String? // predecessor; null for v1

    features         Json // FeatureKey[]
    quotas           Json @default("{}") // Record<QuotaKey, number>
    compatibility    Json @default("{}") // BundleCompatibility
    pricingOverrides Json @default("[]") // BundlePricingOverride[]

    monthlyNet Decimal? @db.Decimal(10, 2) // default price; null = only via override
    yearlyNet  Decimal? @db.Decimal(10, 2)
    marketed   Boolean  @default(true)

    publishedAt      DateTime?
    supersededAt     DateTime?
    publishedChanges Json? // VersionChange[] — diff to predecessor version
    changeNote       String  @default("")
    nonRegressive    Boolean @default(true)

    // Booking window for new subscriptions. Both columns are nullable so this
    // schema change is additive and existing rows remain valid.
    validFrom  DateTime?
    validUntil DateTime?

    createdByUserId   String?
    publishedByUserId String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    bundle              Bundle               @relation(fields: [bundleId], references: [id], onDelete: Cascade)
    baseVersion         BundleVersion?       @relation("BundleVersionLineage", fields: [baseVersionId], references: [id])
    derivedVersions     BundleVersion[]      @relation("BundleVersionLineage")
    // Standalone add-on bookings pinned to this version, and the ones set to
    // continue on it at the end of their term (see the SubscriptionBundle model
    // below).
    subscriptionBundles        SubscriptionBundle[] @relation("SubscriptionBundleVersion")
    subscriptionBundlesPending SubscriptionBundle[] @relation("SubscriptionBundlePendingVersion")

    @@unique([bundleId, version])
    @@index([bundleId, supersededAt])
    @@index([bundleId, publishedAt])
    @@index([bundleId, validFrom])
    @@map("bundle_versions")
}

// =============================================================================
// SaaS-Platform Prisma fragment: Promotion (time-scheduled pricing campaigns)
// =============================================================================
//
// REFERENCE SNIPPET — see 03-plan-versions.prisma for conventions.
//
// A Promotion is a catalog-side, time-limited pricing campaign.
// It overrides the pricing-page price automatically (without entering a code,
// unless `requiresCoupon`). Separate from `PromoCode` (a redeemable
// checkout voucher, 02-promo-code.prisma) — `requiresCoupon = true`
// couples a Promotion to existing PromoCode codes via `codes`.
//
// Global catalog table (no tenantId, no RLS). Write access only
// via the SUPER_ADMIN guard in the AdminController.

model Promotion {
    id String @id @default(uuid())

    // Internal label (not public).
    internalLabel String

    // Campaign type: percent | amount | intro | freeMonths
    type String

    // Type-dependent value:
    //   percent/amount → number
    //   intro          → { price, months }
    //   freeMonths     → number
    value Json

    // Target type of the keys in `appliesTo`: PLAN | BUNDLE | OFFER.
    // Null/missing in legacy records is interpreted as PLAN.
    targetType String @default("PLAN")

    // Target keys the campaign applies to.
    appliesTo Json @default("[]") // string[]

    // Billing cycle: monthly | yearly | both
    billingCycle String @default("both")

    validFrom DateTime
    validTo   DateTime

    // On overlap, the highest value wins.
    priority Int @default(0)

    // Language restriction; null = all locales.
    onlyLocales Json? // string[] | null

    requiresCoupon Boolean @default(false)
    codes          Json    @default("[]") // string[] — referenced PromoCode codes

    // UI accent color (timeline/ribbon).
    color String @default("#2563eb")

    // Locale texts { "de": { badge, fineprint }, … }.
    i18n Json @default("{}")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([targetType, validFrom, validTo])
    @@map("promotions")
}

// =============================================================================
// SaaS platform Prisma fragment: SubscriptionContract + ContractLineItem
// =============================================================================
//
// REFERENCE SNIPPET — not a standalone schema. Consumers copy the models into
// their `schema.prisma` and add FK relations to Tenant/User.
//
// V3 rule: billing and entitlement must not depend on live-mutable catalog
// tables. `SubscriptionContract` and `ContractLineItem` therefore store full
// snapshots. Catalog FKs are optional and only audit/trace references.

enum SubscriptionContractStatus {
    active
    scheduled
    terminated
    superseded
}

enum ContractLineItemKind {
    plan
    bundle
    quota
    feature
    discount
}

model SubscriptionContract {
    id       String @id @default(uuid())
    tenantId String

    // Who the contract is between, copied on the day it is concluded: the
    // subscriber as its record stood, and the issuer as `config/saas.yaml`
    // named it — null where it named none. Neither copy follows a later change
    // to the subscriber or the configuration. The invoice email is not copied:
    // it says how the party is reached, not who it is.
    subscriberId       String
    subscriberSnapshot Json
    issuerSnapshot     Json?
    // The copies were made by the migration that attached contracts concluded
    // before subscribers existed, not at conclusion, and are never presented as
    // what was agreed.
    partiesMigrated    Boolean @default(false)

    // The tax treatment the installation's tax adapter decided when the
    // contract was concluded: its kind, rate and note, with the adapter's name
    // and version (ADR 0013). Null where no adapter was asked — an installation
    // without one, a contract from before, or a path that does not ask one
    // yet; each invoice then takes the adapter's answer when it is issued.
    taxTreatment Json?

    // The days of notice a cancellation of the contract is judged by, in its
    // rhythm: what config/saas.yaml named for that rhythm when the subscriber
    // concluded or changed the contract, kept by a successor the operator or
    // the platform writes, never what the file names later.
    cancellationNoticeDays Int
    // The version of the operator's terms config/saas.yaml named when the
    // subscriber concluded or changed the contract, kept by a successor the
    // operator or the platform writes; null where it named none.
    termsVersion String?
    // When the subscriber agreed to termsVersion and cancellationNoticeDays.
    agreedAt     DateTime
    // Whether the contract is due a confirmation (26-contract-confirmation.prisma):
    // the repository writes it true on every contract it creates. False by
    // default, so the column db push adds leaves every contract already there
    // unconfirmed, whatever order the migrations run in.
    confirmationDue Boolean @default(false)

    status         SubscriptionContractStatus @default(active)
    effectiveFrom  DateTime
    effectiveUntil DateTime?

    // Optional trace back to the offer/catalog. The contract stays valid even
    // when these target objects are archived or physically deleted.
    originalOfferId          String?
    originalPlanVersionId    String?
    originalBundleVersionIds Json @default("[]")

    // Full snapshots for runtime, billing, and later display.
    entitlementSnapshot Json?
    priceSnapshot       Json
    promotionSnapshots  Json @default("[]")
    promoCodeSnapshots  Json @default("[]")
    termsSnapshot       Json?

    lineItems           ContractLineItem[]
    ledgerEntries       SubscriberLedgerEntry[]
    invoices            SubscriptionInvoice[]
    confirmation        ContractConfirmation?
    confirmationArchive ContractConfirmationArchive?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // No relation to `Tenant`: the contract belongs to its subscriber and
    // outlives the tenant, whose id stays here as a trace.
    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([tenantId, status, effectiveFrom])
    @@index([subscriberId])
    @@index([status])
    @@index([originalOfferId])
    @@map("subscription_contracts")
}

model ContractLineItem {
    id         String @id @default(uuid())
    contractId String

    kind            ContractLineItemKind
    sourceKey       String
    sourceVersionId String?

    titleSnapshot       String
    descriptionSnapshot String?

    quantity     Int     @default(1)
    unit         String?
    priceNet     Decimal @db.Decimal(10, 2)
    priceGross   Decimal @db.Decimal(10, 2)
    billingCycle String // monthly | yearly

    currency  String
    taxRate   Decimal @db.Decimal(5, 2)
    taxAmount Decimal @db.Decimal(10, 2)

    minimumTermUntil DateTime?

    featuresSnapshot     Json @default("[]")
    quotaEffectsSnapshot Json @default("{}")
    metadata             Json?

    createdAt DateTime @default(now())

    contract      SubscriptionContract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
    ledgerEntries SubscriberLedgerEntry[]
    invoiceLines  SubscriptionInvoiceLine[]

    @@index([contractId, kind])
    @@index([sourceVersionId])
    @@map("contract_line_items")
}

// =============================================================================
// SaaS-Platform Prisma fragment: SubscriptionBundle (standalone add-on booking)
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// A SubscriptionBundle is a bundle booked ON TOP of a subscription's plan —
// the tenant "bundle store". It pins a concrete BundleVersion (features/quotas
// frozen at booking), carries its own minimum term and cancellation window,
// and is billed independently of the plan. The reverse relations are enabled
// on Subscription (`bundles`) and BundleVersion (`subscriptionBundles`).

model SubscriptionBundle {
    id              String @id @default(uuid())
    subscriptionId  String
    bundleVersionId String

    startedAt DateTime

    // Minimum contractual term; a cancellation before this date takes effect
    // only at `minimumTermEndsAt`.
    minimumTermEndsAt DateTime?

    // The rhythm this booking is billed in, and the window it is billed
    // for. A bundle ends on the day its plan does.
    billingCycle       String?
    currentPeriodStart DateTime?
    currentPeriodEnd   DateTime?

    // A switch to a newer version taken for the end of the booking's term:
    // the version it continues on, and from when.
    pendingBundleVersionId    String?
    pendingVersionEffectiveAt DateTime?
    // What the subscriber agreed to when they scheduled that switch, the same
    // three a scheduled plan change records.
    pendingTermsVersion           String?
    pendingCancellationNoticeDays Int?
    pendingAgreedAt               DateTime?

    // What the subscriber agreed to by making the booking, for a contract
    // written for it later; null on a booking made before these existed.
    agreedTermsVersion           String?
    agreedCancellationNoticeDays Int?
    agreedAt                     DateTime?

    // Cancellation: requested at `canceledAt`, effective at
    // `canceledEffectiveAt` (period/term end). Both null = active booking.
    canceledAt          DateTime?
    canceledEffectiveAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // The subscription this add-on is booked on. Restrict the BundleVersion so
    // a booked version cannot be hard-deleted from the catalog.
    subscription         Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
    bundleVersion        BundleVersion  @relation("SubscriptionBundleVersion", fields: [bundleVersionId], references: [id], onDelete: Restrict)
    pendingBundleVersion BundleVersion? @relation("SubscriptionBundlePendingVersion", fields: [pendingBundleVersionId], references: [id], onDelete: Restrict)

    @@index([subscriptionId])
    @@index([bundleVersionId])
    @@index([canceledEffectiveAt])
    @@index([pendingVersionEffectiveAt])
    @@map("subscription_bundles")
}

// =============================================================================
// SaaS-Platform Prisma fragment: the applied settings, and their changes
// =============================================================================
//
// What the installation is running on, since when, and what changed between
// two starts. The platform writes both tables at boot and reads them for the
// read-only settings screen — the record is a mirror of config/saas.yaml, never
// a source. One row per installation, held to one by the CHECK the entrypoint
// applies from @saasicat/spec/sql/constraints.postgres.sql.

model AppliedSettings {
    id          String   @id @default("installation")
    fingerprint String
    settings    Json
    source      String
    appliedAt   DateTime

    @@map("applied_settings")
}

model SettingsChange {
    id             String    @id @default(uuid())
    seq            Int       @unique @default(autoincrement())
    noticedAt      DateTime
    source         String
    previous       Json
    current        Json
    acknowledgedAt DateTime?
    acknowledgedBy String?

    @@index([acknowledgedAt, noticedAt])
    @@map("settings_changes")
}

// =============================================================================
// Maintenance windows (16-maintenance-window.prisma)
// =============================================================================
//
// Announced to the tenants, locked for a deploy, ended when the operator
// unlocks. At most one is open at a time — held by the partial unique index the
// entrypoint applies from @saasicat/spec/sql/constraints.postgres.sql.

model MaintenanceWindow {
    id        String    @id @default(uuid())
    startsAt  DateTime?
    endsAt    DateTime?
    message   String?
    createdAt DateTime  @default(now())
    createdBy String
    lockedAt  DateTime?
    lockedBy  String?
    endedAt   DateTime?
    endedBy   String?

    @@index([createdAt])
    @@map("maintenance_windows")
}

// =============================================================================
// Subscription notices (17-subscription-notice.prisma)
// =============================================================================

// What each subscriber was told, once per subscription, kind and subject. The
// tenant and the subscription are kept as values: the record outlives them.
model SubscriptionNotice {
    id             String @id @default(uuid())
    tenantId       String
    subscriptionId String

    kind    String
    subject String
    content Json

    createdAt             DateTime  @default(now())
    claimedAt             DateTime?
    deliveredAt           DateTime?
    recipients            Json?
    channel               String?
    recipientCount        Int?
    recipientsForgottenAt DateTime?

    @@unique([subscriptionId, kind, subject])
    @@index([kind, subject])
    @@index([tenantId])
    @@map("subscription_notices")
}

// =============================================================================
// VersionRetirement — every retirement an operator announces (18-version-retirement.prisma)
// =============================================================================

model VersionRetirement {
    id String @id @default(uuid())

    retiredPlanVersionId String
    retiredPlanKey       String
    retiredVersion       Int

    replacementPlanVersionId String
    replacementPlanKey       String
    replacementVersion       Int

    announcedAt DateTime @default(now())
    announcedBy String

    @@index([retiredPlanVersionId])
    @@map("version_retirements")
}

// =============================================================================
// BundleVersionRetirement — every add-on retirement an operator announces (19-bundle-version-retirement.prisma)
// =============================================================================

model BundleVersionRetirement {
    id String @id @default(uuid())

    retiredBundleVersionId String
    retiredBundleKey       String
    retiredVersion         Int

    replacementBundleVersionId String
    replacementBundleKey       String
    replacementVersion         Int

    announcedAt DateTime @default(now())
    announcedBy String

    @@index([retiredBundleVersionId])
    @@map("bundle_version_retirements")
}

// =============================================================================
// FeatureWithdrawal — every feature withdrawn for an external reason (21-feature-withdrawal.prisma)
// =============================================================================

model FeatureWithdrawal {
    id         String @id @default(uuid())
    featureKey String
    reason     String

    effectiveFrom DateTime
    liftedFrom    DateTime?

    reductions Json @default("[]")

    announcedAt DateTime  @default(now())
    announcedBy String
    liftedAt    DateTime?
    liftedBy    String?
    toldAt      DateTime?

    @@index([featureKey])
    @@map("feature_withdrawals")
}

// =============================================================================
// Subscriber — the party a contract is concluded with (13-subscriber.prisma)
// =============================================================================

model Subscriber {
    id String @id @default(uuid())

    // The customer number, counted per installation. The number orders; the
    // prefix is the one `config/saas.yaml` named when the subscriber was
    // created, kept beside it so a later prefix renames nobody. Counting starts
    // at 10001 (sql/constraints.postgres.sql), so numbers have five digits long
    // before they need a sixth.
    customerSequence     Int    @unique @default(autoincrement())
    customerNumberPrefix String @default("")

    // The legal identity. Only the name is required until invoicing requires
    // the rest; under a running contract these change only as a correction,
    // recorded in `SubscriberCorrection`.
    legalName String
    vatId     String?
    taxNumber String?

    // The tax origin beside the country and the VAT id (ADR 0013): whether the
    // subscriber is a business, as sign-up or the operator recorded it — null
    // while nobody has said, and never derived from a tax identifier, since a
    // business outside the European Union may have none. A change of the
    // country, the business status or the VAT id is recorded in
    // `SubscriberTaxOriginChange`.
    business Boolean?

    // Which recorded check of the VAT id counts now (`SubscriberVatIdCheck`):
    // the latest completed one of the number the subscriber has. Null while
    // none does — never checked, or the number corrected since. A reference
    // without a relation: the check already points at its subscriber, and a
    // key in both directions would tie each row to the other.
    currentVatIdCheckId String?
    // Since when the VAT id is held, set by the correction that wrote it; null
    // while it is the one the subscriber was created with. A check completed
    // before it does not count for the number.
    vatIdSince          DateTime?

    // Contact details, which change at any time.
    addressLine1 String?
    addressLine2 String?
    postalCode   String?
    city         String?
    country      String? // ISO 3166-1 alpha-2
    invoiceEmail String?

    // Created by the migration that gave every existing tenant its subscriber,
    // from the application's own tenant record.
    migrated Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    tenants             SubscriberTenant[]
    corrections         SubscriberCorrection[]
    taxOriginChanges    SubscriberTaxOriginChange[]
    vatIdChecks         SubscriberVatIdCheck[]
    contracts           SubscriptionContract[]
    paymentMethods      SubscriberPaymentMethod[]
    paymentMethodSetups SubscriberPaymentMethodSetup[]
    ledgerEntries       SubscriberLedgerEntry[]
    invoices            SubscriptionInvoice[]
    payments            SubscriberPayment[]
    credits             SubscriberCredit[]
    refunds             SubscriberRefund[]
    reversals           SubscriberReversal[]
    reconciliationCases SubscriberReconciliationCase[]
    tenantDeletions     SubscriberTenantDeletion[]
    joinedInto          SubscriberJoin?  @relation("SubscriberJoinFrom")
    joinedFrom          SubscriberJoin[] @relation("SubscriberJoinInto")

    @@map("subscribers")
}

// Which tenant a subscriber is live for, and which it was before. A subscriber
// has at most one live tenant and a tenant at most one live subscriber — two
// partial unique indexes in sql/constraints.postgres.sql, which Prisma cannot
// express. `unlinkedAt` stays null while the link is live.
model SubscriberTenant {
    id           String    @id @default(uuid())
    subscriberId String
    tenantId     String
    linkedAt     DateTime  @default(now())
    unlinkedAt   DateTime?

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([tenantId])
    @@index([subscriberId])
    @@map("subscriber_tenants")
}

// A correction of a subscriber's legal identity: the values it replaced, the
// values it wrote, why, who made it, and when the write held the subscriber's
// lock. Only the fields that moved are in the two JSON objects. Written in the
// same transaction as the change, and never rewritten.
model SubscriberCorrection {
    id           String   @id @default(uuid())
    // The order the corrections were written in, numbered by the database at
    // the write, and the order the list is read in. Never set by the platform.
    seq          Int      @unique @default(autoincrement())
    subscriberId String
    previous     Json
    corrected    Json
    reason       String
    correctedBy  String
    correctedAt  DateTime

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([subscriberId, seq])
    @@map("subscriber_corrections")
}

// A change of a subscriber's tax origin — its country, whether it is a
// business, its VAT id — whichever way it arrived: a contact change, a
// correction of the legal identity, a change of the business status. The
// values it replaced, the values it wrote, who made it, and when the write
// held the subscriber's lock; only the fields that moved are in the two JSON
// objects. Written in the same transaction as the change, never rewritten, and
// applied from the subscriber's next invoice.
model SubscriberTaxOriginChange {
    id           String   @id @default(uuid())
    // The order the changes were written in, numbered by the database at the
    // write, and the order the list is read in. Never set by the platform.
    seq          Int      @unique @default(autoincrement())
    subscriberId String
    previous     Json
    changed      Json
    changedBy    String
    changedAt    DateTime
    // Why: the reason of the correction or of the change of business status
    // that made it; null for a change of the country with the contact details.
    reason       String?

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([subscriberId, seq])
    @@map("subscriber_tax_origin_changes")
}

// A completed check of a subscriber's VAT id, as the service answered it: the
// number checked, when the answer came, whether it found the number valid, the
// service and its confirmation. Recorded for every check, whether it counts or
// not, and never rewritten: a reverse charge rests on the confirmation that
// held when the invoice was issued (ADR 0013).
model SubscriberVatIdCheck {
    id           String   @id @default(uuid())
    subscriberId String
    vatId        String
    checkedAt    DateTime
    valid        Boolean
    service      String
    confirmation Json
    recordedAt   DateTime @default(now())

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@index([subscriberId, checkedAt])
    @@map("subscriber_vat_id_checks")
}

// A returning customer's new subscriber joined into the one it had — see
// 27-subscriber-join.prisma; sql/1.0-a-subscriber-is-joined.postgres.sql adds the
// triggers `db push` cannot create.
model SubscriberJoin {
    id               String   @id @default(uuid())
    fromSubscriberId String   @unique
    intoSubscriberId String
    reason           String
    joinedBy         String
    joinedAt         DateTime
    digest           String
    moved            Json

    from Subscriber @relation("SubscriberJoinFrom", fields: [fromSubscriberId], references: [id], onDelete: Restrict)
    into Subscriber @relation("SubscriberJoinInto", fields: [intoSubscriberId], references: [id], onDelete: Restrict)

    @@index([intoSubscriberId])
    @@map("subscriber_joins")
}

// =============================================================================
// Payments — the subscriber's payment method and the gateway events
// (14-payments.prisma)
// =============================================================================

model SubscriberPaymentMethod {
    id           String @id @default(uuid())
    subscriberId String

    // The account the references below belong to, and its provider when the
    // payment method was confirmed.
    gatewayAccount   String
    provider         String
    customerRef      String
    paymentMethodRef String

    // What tells the payment method apart, never enough to pay with it.
    type             String // card | sepa_debit
    brand            String?
    last4            String
    expiryMonth      Int?
    expiryYear       Int?
    country          String? // ISO 3166-1 alpha-2
    bankCode         String?
    mandateReference String?

    status      String    @default("ACTIVE") // ACTIVE | REPLACED
    confirmedAt DateTime
    replacedAt  DateTime?
    createdAt   DateTime  @default(now())

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@unique([gatewayAccount, paymentMethodRef])
    @@index([subscriberId, status])
    @@index([gatewayAccount, status])
    @@map("subscriber_payment_methods")
}

// A change of payment method a tenant started: the gateway session opened for
// the subscriber. A confirmation is recorded only against the setup whose
// account, session and subscriber it names, and completes it on the same
// transaction — so a callback naming another subscriber than the session was
// opened for changes nobody's payment method. A setup nobody finishes stays
// open; it holds no reference that could be charged.
model SubscriberPaymentMethodSetup {
    id             String    @id @default(uuid())
    subscriberId   String
    gatewayAccount String
    sessionRef     String
    customerRef    String
    startedAt      DateTime  @default(now())
    completedAt    DateTime?

    subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

    @@unique([gatewayAccount, sessionRef])
    @@index([subscriberId])
    @@map("subscriber_payment_method_setups")
}

// PaymentEventLog — every payment gateway event, handled once.
// Gateways deliver at least once. An event is claimed on the transaction that
// writes what it changes, so a retry after a rollback is handled and a retry
// after a commit finds the claim. `eventId` is unique only within the gateway
// account that sent it — two accounts side by side never take each other's
// event for a duplicate. `status` holds the event's kind as SaaSiCat read it
// (`payment-method-confirmed`, …) and `payload` a summary that names no person.
model PaymentEventLog {
    id             String   @id @default(cuid())
    gatewayAccount String
    eventId        String
    provider       String
    sessionId      String?
    status         String
    payload        Json?
    processedAt    DateTime @default(now())

    @@unique([gatewayAccount, eventId])
    @@index([sessionId])
    @@index([status, processedAt])
}

// =============================================================================
// Terms — the versions of the operator's terms
// (25-terms.prisma)
// =============================================================================

// The versions of the operator's terms, one PDF per version, archived once by
// the start; a contract records the version it was concluded under. The
// migration installs triggers that refuse every UPDATE, DELETE and TRUNCATE.
model TermsVersion {
    version    String   @id
    // SHA-256 of `content`, 64 lower-case hex digits.
    checksum   String
    mediaType  String
    fileName   String
    content    Bytes
    archivedAt DateTime

    @@map("terms_versions")
}

// =============================================================================
// Tenant access holds (28-tenant-access-hold.prisma)
// =============================================================================

// One row per reason a tenant is held back — a suspension, an overdue invoice,
// an ended subscription. Open until lifted; the tenant's state is the strictest
// open reason. One open row per tenant, kind and reference — held by the partial
// unique index the entrypoint applies from @saasicat/spec/sql/constraints.postgres.sql.

model TenantAccessHold {
    id         String    @id @default(uuid())
    tenantId   String
    kind       String
    reference  String?
    note       String?
    since      DateTime
    recordedBy String
    liftedAt   DateTime?
    liftedBy   String?
    createdAt  DateTime  @default(now())

    @@index([tenantId, liftedAt])
    @@map("tenant_access_holds")
}

model SubscriptionEnd {
    id             String   @id @default(uuid())
    tenantId       String
    subscriptionId String   @unique
    endsAt         DateTime
    deletesOn      DateTime @db.Date
    recordedAt     DateTime
    recordedBy     String
    createdAt      DateTime @default(now())

    @@index([tenantId])
    @@index([deletesOn])
    @@map("subscription_ends")
}

model SubscriptionEndAnnouncement {
    id             String   @id @default(uuid())
    tenantId       String
    subscriptionId String   @unique
    endsAt         DateTime
    readOnlyDays   Int
    deletesOn      DateTime @db.Date
    announcedAt    DateTime
    announcedBy    String
    createdAt      DateTime @default(now())

    @@index([tenantId])
    @@map("subscription_end_announcements")
}

model TenantExportDownload {
    id                 String   @id @default(uuid())
    tenantId           String
    subscriptionId     String
    downloadedAt       DateTime
    downloadedBy       String
    downloadedByUserId String
    size               BigInt
    createdAt          DateTime @default(now())

    @@index([subscriptionId])
    @@map("tenant_export_downloads")
}

// =============================================================================
// Installation mark (32-installation-mark.prisma)
// =============================================================================
//
// The identifier of the installation this database belongs to. A tenant is
// deleted only where it names the identifier the process's environment names
// (SAASICAT_INSTALLATION), and no start writes it: the operator does, with
// `<app> installation mark <identifier>`. One row per installation, held to
// one by the CHECK the entrypoint applies from
// @saasicat/spec/sql/constraints.postgres.sql.

model InstallationMark {
    id         String   @id @default("installation")
    identifier String
    markedAt   DateTime
    markedBy   String

    @@map("installation_marks")
}

// =============================================================================
// Tenant deletions (33-subscriber-tenant-deletion.prisma)
// =============================================================================
//
// The record of each tenant's deletion, kept with its subscriber: what each of
// the app's stores counted before it erased, when each confirmed, what the
// tenant was told to keep, and the subscriber's commercial record before and
// after. It names no person, and outlives the tenant as the invoices do.
// The checks and the partial unique index on kept categories are applied by the
// entrypoint from @saasicat/spec/sql/constraints.postgres.sql.

model SubscriberTenantDeletion {
    id                        String    @id @default(uuid())
    tenantId                  String    @unique
    subscriberId              String
    subscriptionId            String
    subscriptionEndId         String
    deletesOn                 DateTime  @db.Date
    exportOfferedFrom         DateTime
    exportBlockedBySuspension Boolean
    commercialBefore          Json?
    commercialAfter           Json?
    startedAt                 DateTime
    claimedAt                 DateTime?
    attempts                  Int       @default(0)
    lastFailure               Json?
    halt                      String?
    closedAt                  DateTime?
    createdAt                 DateTime  @default(now())

    subscriber Subscriber                      @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    stores     SubscriberTenantDeletionStore[]
    counts     SubscriberTenantDeletionCount[]

    @@index([subscriberId])
    @@index([closedAt])
    @@map("subscriber_tenant_deletions")
}

model SubscriberTenantDeletionStore {
    id         String    @id @default(uuid())
    deletionId String
    store      String
    position   Int
    countedAt  DateTime?
    erasedAt   DateTime?

    deletion SubscriberTenantDeletion @relation(fields: [deletionId], references: [id], onDelete: Restrict)

    @@unique([deletionId, store])
    @@unique([deletionId, position])
    @@map("subscriber_tenant_deletion_stores")
}

model SubscriberTenantDeletionCount {
    id         String  @id @default(uuid())
    deletionId String
    kind       String
    store      String?
    category   String
    count      Int
    labels     Json?

    deletion SubscriberTenantDeletion @relation(fields: [deletionId], references: [id], onDelete: Restrict)

    @@unique([deletionId, kind, store, category])
    @@map("subscriber_tenant_deletion_counts")
}

// =============================================================================
// SaaS platform Prisma fragment: SubscriberLedgerEntry
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// The subscriber's account: one row per charge that became due, one per
// contract line and period. The platform derives each charge from the contract
// in force, the billing windows and the bookings, and writes it once — the
// unique index below is what makes a second derivation of the same charge a
// no-op, however many run at the same time. A row is never updated or deleted:
// a mistake is answered with a counter-entry.
//
// A charge is net. The tax is the invoice's, decided by the tax adapter when
// the charge is invoiced (ADR 0013), so this table records the amount, its
// currency and the period, and nothing that a later invoice would have to
// agree with to the cent.
//
// The account belongs to the subscriber, not to the tenant, and outlives it
// (ADR 0012): `tenantId` and `subscriptionId` are kept as values, and the keys
// that point anywhere point at the subscriber and the contract line, which are
// kept as long as the documents that need them.
//
// `origin` and `source` are text holding a closed set, checked when a row is
// read (`toSubscriberChargeRecord` in @saasicat/core):
//   origin: activation | renewal | planChange | bundleBooking | bundleChange | credit | correction
//           | reductionTakenBack
//   source: plan | bundle | discount
//
// A `correction` is a counter-entry: written only by the cancellation of the
// invoice its charge stood on, it names that charge, that invoice and the
// reason, and only that cancellation's replacement invoices it — the invoice
// run never does. Its `sourceRef` is `<invoiceId>/<chargeId>`, so each
// correction is an entry of its own under the unique index.
//
// Optional: adopt it where `tenantBilling.chargeJournal` is configured, which
// needs frozen contracts (`contractFreeze`).
//
// Contract: @saasicat/core (SubscriberLedgerRepository).

model SubscriberLedgerEntry {
    id                 String @id @default(uuid())
    subscriberId       String
    tenantId           String
    subscriptionId     String
    contractId         String
    contractLineItemId String

    origin String
    source String
    // The subscription id for the plan, the booking id for an add-on, the
    // discount's key — stable across the contracts that replace one another.
    sourceRef String

    periodStart DateTime
    periodEnd   DateTime

    currency  String
    amountNet Decimal @db.Decimal(10, 2)

    bookedAt  DateTime
    createdAt DateTime @default(now())

    // A correction's three parts, all set on a correction and none on any
    // other charge (`toSubscriberChargeRecord`). The invoice is a value rather
    // than a key, so the journal stands without the invoice fragments.
    correctsChargeId   String?
    correctedInvoiceId String?
    correctionReason   String?

    subscriber       Subscriber           @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    contract         SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
    contractLineItem ContractLineItem     @relation(fields: [contractLineItemId], references: [id], onDelete: Restrict)
    // The lines that invoice it: the invoice it was first issued on, and the
    // cancellation and replacement of each invoice of that chain.
    invoiceLines     SubscriptionInvoiceLine[] // see 20-subscription-invoice.prisma
    // The charge a correction corrects, and the corrections of a charge.
    corrects         SubscriberLedgerEntry?    @relation("ChargeCorrection", fields: [correctsChargeId], references: [id], onDelete: Restrict)
    correctedBy      SubscriberLedgerEntry[]   @relation("ChargeCorrection")

    @@unique([subscriptionId, source, sourceRef, periodStart, origin])
    @@index([subscriberId, bookedAt])
    @@index([contractLineItemId])
    @@index([correctsChargeId])
    @@map("subscriber_ledger_entries")
}

// =============================================================================
// SaaS platform Prisma fragment: SubscriptionInvoice
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// The invoices issued from the charge journal (15-subscriber-ledger.prisma):
// the charges a billing period opens with on one invoice, a charge that arises
// later on an invoice of its own. An invoice copies everything it states when
// it is issued — the issuer, the subscriber, the tax treatment the adapter
// decided, the tax per rate — so a later change leaves it as it was. Nothing
// updates or deletes an invoice; a correction is a cancellation invoice and its
// replacement (`SubscriptionInvoiceCancellation`), written together.
//
// An invoice and the invoices that correct it are one chain (`SC-PRIC-036`):
// `chainId` names the invoice it began with — its own id for an invoice issued
// on the journal's charges — and `chainStep` its step there: 0 that invoice, 1
// its cancellation, 2 the replacement, 3 the replacement's cancellation and so
// on. Whatever changes what an invoice of a chain owes or how it is collected —
// a payment, a reversal, a cancellation, a collection attempt — takes the turn
// of the chain's first invoice, so two of them never read the same replacement
// at once.
//
// A line invoices one charge, and a charge stands on one line per step of a
// chain — the invoice it was first issued on, its cancellation, the
// replacement: the unique (`chargeId`, `chainStep`) is what makes a second run
// issuing the same charges write nothing, however many run at the same time.
//
// The number range is the table `subscription_invoice_numbers`, one row per
// year holding the last number drawn. An invoice draws its number by raising
// that row in the transaction that writes the invoice, so an invoice that
// fails to be written leaves no gap, and two at the same time wait for each
// other rather than drawing the same number. One installation is the range of
// one issuer; the number is `<prefix>-<year>-<sequence>`.
//
// The days an invoice states — its issue date, its due date, the period its
// charges cover, a direct debit's collection date — are calendar days in the
// installation's time zone, kept as `date` columns; `issuedAt` is the instant
// it was issued.
//
// `origin` and `source` on a line are text holding the charge's closed sets,
// checked when a row is read (`toSubscriptionInvoiceRecord` in @saasicat/core).
//
// Optional: adopt it, all five models together, where
// `tenantBilling.chargeJournal.invoices` is configured, which needs the charge
// journal.
//
// Contract: @saasicat/core (SubscriptionInvoiceRepository).

model SubscriptionInvoice {
    id             String @id @default(uuid())
    number         String @unique
    numberPrefix   String
    numberYear     Int
    numberSequence Int

    tenantId       String
    subscriberId   String
    subscriptionId String
    contractId     String

    chainId   String
    chainStep Int    @default(0)

    issuedAt           DateTime
    issueDate          DateTime @db.Date
    dueDate            DateTime @db.Date
    servicePeriodFrom  DateTime @db.Date
    servicePeriodUntil DateTime @db.Date

    // The payment method it is collected with, copied when it was issued —
    // its id, account, type and masked details, and a direct debit's mandate
    // reference; null where it is not collected. A direct debit's collection
    // date, which the invoice announces and falls due on; null otherwise.
    payment        Json?
    collectionDate DateTime? @db.Date

    currency        String
    // The parties as the invoice names them, copied when it was issued.
    issuerParty     Json
    subscriberParty Json
    // The footer lines config/saas.yaml named on the issue date (SC-PRIC-093).
    footer          Json    @default("[]")
    // The adapter's treatment, with its name and version, and the tax per rate.
    taxTreatment    Json
    taxes           Json
    totalNet        Decimal @db.Decimal(12, 2)
    totalTax        Decimal @db.Decimal(12, 2)
    totalGross      Decimal @db.Decimal(12, 2)
    // What a replacement took over, when it was issued, of what was paid for
    // the invoice it replaces (`SC-PRIC-095`); its document states it as paid.
    // Zero on every other invoice.
    paidOnIssue     Decimal @default(0) @db.Decimal(12, 2)

    createdAt DateTime @default(now())

    subscriber Subscriber                   @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    contract   SubscriptionContract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
    lines      SubscriptionInvoiceLine[]
    document    SubscriptionInvoiceDocument?
    archive     SubscriptionInvoiceArchive?
    collections SubscriptionInvoiceCollection[]
    payments    SubscriberPayment[]             // see 24-subscriber-payments.prisma
    settlements SubscriptionInvoiceSettlement[]
    credit      SubscriberCredit?

    chainStart    SubscriptionInvoice              @relation("SubscriptionInvoiceChain", fields: [chainId], references: [id], onDelete: Restrict)
    chainInvoices SubscriptionInvoice[]            @relation("SubscriptionInvoiceChain")
    cancelledBy   SubscriptionInvoiceCancellation? @relation("CancelledInvoice")
    cancels       SubscriptionInvoiceCancellation? @relation("CancellationInvoice")
    replaces      SubscriptionInvoiceCancellation? @relation("ReplacementInvoice")

    @@unique([numberYear, numberSequence])
    @@index([subscriberId, issuedAt])
    @@index([subscriptionId])
    @@index([chainId])
    @@map("subscription_invoices")
}

model SubscriptionInvoiceLine {
    id                 String @id @default(uuid())
    invoiceId          String
    position           Int
    chargeId           String
    contractLineItemId String
    // The step of its invoice in the chain.
    chainStep          Int    @default(0)
    // On a cancellation, the position of the line it cancels; on a replacement,
    // of the line it replaces, on the invoice the cancellation names
    // (`SC-AUD-013`). Null on an invoice's own line.
    correctedPosition  Int?
    // On a correction's line, the position on this same invoice of the line
    // whose charge it corrects, so the document can say which (`SC-AUD-013`).
    // Null on every other line; `constraints.postgres.sql` holds which.
    correctsPosition   Int?

    title  String
    origin String
    source String

    periodFrom  DateTime @db.Date
    periodUntil DateTime @db.Date

    amountNet Decimal @db.Decimal(10, 2)
    taxRate   Decimal @db.Decimal(5, 2)

    invoice          SubscriptionInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    charge           SubscriberLedgerEntry @relation(fields: [chargeId], references: [id], onDelete: Restrict)
    contractLineItem ContractLineItem      @relation(fields: [contractLineItemId], references: [id], onDelete: Restrict)
    corrects         SubscriptionInvoiceLine?  @relation("LineCorrection", fields: [invoiceId, correctsPosition], references: [invoiceId, position], onDelete: Restrict, onUpdate: Restrict)
    correctedBy      SubscriptionInvoiceLine[] @relation("LineCorrection")

    @@unique([chargeId, chainStep])
    @@unique([invoiceId, position])
    @@index([contractLineItemId])
    @@map("subscription_invoice_lines")
}

// A cancellation (`SC-PRIC-095`): the invoice it cancels, the cancellation
// invoice that does, and the replacement for what is still owed — none where
// nothing is —, written in one transaction with both invoices and the moving
// of what was paid (24-subscriber-payments.prisma). The operator's reason, the
// subscriber's details corrected for the replacement — each with the value it
// replaces —, an address to deliver to where the subscriber's record holds no
// invoice email (`SC-PRIC-094`), who cancelled and when. An invoice is
// cancelled once: the unique `cancelledInvoiceId` refuses a second.
model SubscriptionInvoiceCancellation {
    id                    String   @id @default(uuid())
    cancelledInvoiceId    String   @unique
    cancellationInvoiceId String   @unique
    replacementInvoiceId  String?  @unique
    reason                String
    correctedSubscriber   Json?
    deliverTo             String?
    cancelledBy           String
    cancelledAt           DateTime

    cancelledInvoice    SubscriptionInvoice             @relation("CancelledInvoice", fields: [cancelledInvoiceId], references: [id], onDelete: Restrict)
    cancellationInvoice SubscriptionInvoice             @relation("CancellationInvoice", fields: [cancellationInvoiceId], references: [id], onDelete: Restrict)
    replacementInvoice  SubscriptionInvoice?            @relation("ReplacementInvoice", fields: [replacementInvoiceId], references: [id], onDelete: Restrict)
    settlements         SubscriptionInvoiceSettlement[]
    credits             SubscriberCredit[]

    @@map("subscription_invoice_cancellations")
}

// Where an invoice's document stands. The checksum is recorded once, before
// the file is archived, and every later download is checked against it; the
// archive's confirmation and the delivery are set once each. A rendering with
// another checksum is refused rather than recorded over the first. A run claims
// the mail before it sends it, so of several instances one does.
model SubscriptionInvoiceDocument {
    invoiceId         String    @id
    // SHA-256 of the rendered file, 64 lower-case hex digits.
    checksum          String
    mediaType         String
    fileName          String
    // In bytes.
    size              Int
    renderedAt        DateTime
    // Null while the invoice waits for its document.
    archivedAt        DateTime?
    // When the run mailing it took it on; null while no run holds it.
    deliveryClaimedAt DateTime?
    // Null until the invoice is handed to the mail.
    deliveredAt       DateTime?
    deliveredTo       String?

    invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

    @@index([archivedAt])
    @@map("subscription_invoice_documents")
}

model SubscriptionInvoiceNumber {
    // The year the numbers count in; the range restarts at 1 each year.
    year Int @id
    // The last number drawn in that year.
    last Int

    @@map("subscription_invoice_numbers")
}

// =============================================================================
// SaaSiCat platform Prisma fragment: SubscriptionInvoiceArchive
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// The database archive of the invoices' documents (20-subscription-invoice.prisma):
// one file per invoice, under its invoice, with the checksum recorded when it
// was rendered. A row is written once and never changed: the migration
// `1.0-an-invoice-document-is-archived.postgres.sql` installs a trigger that
// refuses every UPDATE and DELETE, whoever asks. Keep it, with its database
// backups, as long as the law asks — in Germany 8 years from the end of the
// calendar year an invoice was issued in — and in the European Union.
//
// Optional: adopt it where the invoices' documents are kept in the database,
// as `persistence.entitlement.subscriptionInvoiceArchive` keeps them. An
// installation that archives elsewhere, such as object storage with a
// retention lock, binds its own `InvoiceArchivePort` instead.
//
// Contract: @saasicat/core (InvoiceArchivePort).

model SubscriptionInvoiceArchive {
    invoiceId  String   @id
    // SHA-256 of `content`, 64 lower-case hex digits.
    checksum   String
    mediaType  String
    fileName   String
    content    Bytes
    archivedAt DateTime

    invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

    @@map("subscription_invoice_archive")
}

// =============================================================================
// SaaSiCat platform Prisma fragment: SubscriptionInvoiceCollection
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// The attempts to collect an invoice (20-subscription-invoice.prisma) through
// its payment gateway: each request the platform makes, with everything it
// carries, and what became of it. An attempt is written as `SUBMITTED` before
// its request leaves, under the key `saasicat:collect:<invoice>:<attempt>`, so
// a request whose answer was lost is repeated as the same request, after the
// gateway was asked what became of it. `heldAt` is when a run last took it on;
// another run leaves it alone until that is old enough.
//
// An attempt after a failure, or with a payment method that replaced the one
// the invoice named, is planned first: `SCHEDULED` for `collectOn`, with
// nothing sent and neither `submittedAt` nor `heldAt`. A planned direct debit
// is announced to the subscriber before it is collected, and `announcedAt`
// records when; a planned attempt whose payment method is no longer in use is
// `WITHDRAWN`. A succeeded attempt whose payment a reversal took back, opening
// its invoice again, is `REVERSED` (24-subscriber-payments.prisma), and the
// invoice is collected anew only with another payment method. `followedUpAt`
// records that what follows a failure or a reversal was decided.
//
// An invoice has at most one attempt that is open (`SCHEDULED`, `SUBMITTED`,
// `PENDING`), and none after one succeeded and stands: a partial unique index in
// sql/constraints.postgres.sql, which the Prisma DSL cannot express. `status`,
// `paymentMethodType` and `failureReason` are text holding closed sets, checked
// when a row is read (`toInvoiceCollectionRecord` in @saasicat/core).
//
// Optional: adopt it where invoices are collected through a gateway —
// `tenantBilling.chargeJournal.invoices.collections` — which needs the
// invoices and the payment methods (14-payments.prisma).
//
// Contract: @saasicat/core (InvoiceCollectionRepository).

model SubscriptionInvoiceCollection {
    id                String @id @default(uuid())
    invoiceId         String
    // From 1, per invoice.
    attempt           Int
    attemptKey        String @unique

    // The request as it left, so a repeat is the same request.
    gatewayAccount    String
    paymentMethodId   String
    paymentMethodType String // card | sepa_debit
    customerRef       String
    paymentMethodRef  String
    invoiceNumber     String
    amount            Decimal @db.Decimal(12, 2)
    currency          String

    status        String // SCHEDULED | SUBMITTED | PENDING | SUCCEEDED | FAILED | WITHDRAWN | REVERSED
    // The gateway's reference to what it created for the attempt.
    paymentRef    String?
    failureReason String?
    // The gateway's own code for the failure.
    failureCode   String?

    submittedAt  DateTime?
    heldAt       DateTime?
    resolvedAt   DateTime?
    // The day a planned attempt is collected from.
    collectOn    DateTime? @db.Date
    announcedAt  DateTime?
    followedUpAt DateTime?

    invoice  SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    payments SubscriberPayment[] // see 24-subscriber-payments.prisma

    @@unique([invoiceId, attempt])
    @@index([status, heldAt])
    @@map("subscription_invoice_collections")
}

// =============================================================================
// SaaSiCat platform Prisma fragment: SubscriberPayment, SubscriptionInvoiceSettlement,
// SubscriberCredit, SubscriberCreditEntry, SubscriberRefund, SubscriberReversal,
// SubscriberReconciliationCase
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// What money moved between a subscriber and the operator. A payment is what
// the gateway confirmed for an invoice's collection attempt
// (23-subscription-invoice-collection.prisma), recorded once by its gateway
// account and the gateway's reference however often it is reported. What it
// settles of its invoice is a settlement of its own; what it brought beyond
// that, and an invoice whose total is negative, is a credit the subscriber is
// owed. A credit is never offset against a later invoice: the operator pays it
// out, by a refund in the gateway — recorded when the gateway reports it — or
// by a payout outside it, each an entry against the credit. A refund that
// fails or is canceled gives back what it paid out, as an entry of its own.
//
// A cancellation (20-subscription-invoice.prisma) moves what each payment
// settled of the cancelled invoice onto the replacement, as two settlements of
// that payment — `MOVED_OUT` of the one, `MOVED_IN` of the other —, the oldest
// payment first; what the replacement does not take is a credit that names both
// the payment and the cancellation, so a later reversal of the payment finds
// it as its own (`SC-PRIC-095`, `SC-PRIC-084`).
//
// A reversal — a direct debit the bank returned, a chargeback — takes back
// what its payment brought, the credit first: entries against the credit for
// its open part, and settlements that open the invoice again for the rest. The
// gateway giving it back writes the same entries the other way. What matches
// nothing — a refund no credit takes, a reversal that meets a credit already
// paid out — is a case for the operator to reconcile, closed with a note.
//
// Nothing here is updated but a refund's status, what a reversal withdrew and
// was given back, and a case's closing: every other change is a new row.
// `kind` and `status` are text holding closed sets, checked when a row is read
// (`toSubscriberCreditRecord` and the other readers in @saasicat/core), and so
// is a credit's origin — a payment, an invoice, a reversal, or a payment and
// the cancellation that moved it. A payment leaves at most one credit of its
// own and one per cancellation: two partial unique indexes in
// sql/constraints.postgres.sql, which the Prisma DSL cannot express.
//
// Optional, as one: adopt all seven where invoices are collected through a
// gateway — `tenantBilling.chargeJournal.invoices.payments` — beside the
// collection attempts, which every payment points at.
//
// Contract: @saasicat/core (SubscriberPaymentRepository).

model SubscriberPayment {
    id             String   @id @default(uuid())
    subscriberId   String
    // The tenant the invoice was for, as a trace; no relation to it.
    tenantId       String
    invoiceId      String
    collectionId   String
    gatewayAccount String
    provider       String
    // The gateway's own reference to the payment, unique within its account.
    gatewayRef     String
    amount         Decimal  @db.Decimal(12, 2)
    currency       String
    recordedAt     DateTime @default(now())

    subscriber  Subscriber                    @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    invoice     SubscriptionInvoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    collection  SubscriptionInvoiceCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)
    settlements SubscriptionInvoiceSettlement[]
    credits     SubscriberCredit[]
    refunds     SubscriberRefund[]
    reversals   SubscriberReversal[]
    cases       SubscriberReconciliationCase[]

    @@unique([gatewayAccount, gatewayRef])
    @@index([invoiceId])
    @@index([subscriberId])
    @@map("subscriber_payments")
}

model SubscriptionInvoiceSettlement {
    id         String   @id @default(uuid())
    invoiceId  String
    paymentId  String
    kind       String // PAYMENT | REVERSAL | REINSTATEMENT | MOVED_OUT | MOVED_IN
    // Positive: what a PAYMENT, a REINSTATEMENT or a MOVED_IN takes off what
    // the invoice owes, what a REVERSAL or a MOVED_OUT adds back to it.
    amount     Decimal  @db.Decimal(12, 2)
    // The reversal, for a REVERSAL and its REINSTATEMENT.
    reversalId String?
    // The cancellation that moved it, for a MOVED_OUT and a MOVED_IN.
    cancellationId String?
    recordedAt DateTime @default(now())

    invoice      SubscriptionInvoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
    payment      SubscriberPayment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    reversal     SubscriberReversal?              @relation(fields: [reversalId], references: [id], onDelete: Restrict)
    cancellation SubscriptionInvoiceCancellation? @relation(fields: [cancellationId], references: [id], onDelete: Restrict)

    @@index([invoiceId])
    @@index([paymentId])
    @@index([reversalId])
    @@index([cancellationId])
    @@map("subscription_invoice_settlements")
}

model SubscriberCredit {
    id              String   @id @default(uuid())
    subscriberId    String
    // The tenant it arose in, as a trace; no relation to it.
    tenantId        String
    // What the subscriber is owed, positive.
    amount          Decimal  @db.Decimal(12, 2)
    currency        String
    // The payment that brought more than its invoice owed, the invoice whose
    // total is negative, or the reversal the gateway gave back beyond what the
    // invoices it opened still owed — a reversal can be given back in parts,
    // so it can leave more than one. A credit a cancellation left names the
    // payment whose share the replacement did not take, and the cancellation.
    originPaymentId      String?
    originInvoiceId      String?  @unique
    originReversalId     String?
    originCancellationId String?
    createdAt            DateTime @default(now())

    subscriber         Subscriber                       @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    originPayment      SubscriberPayment?               @relation(fields: [originPaymentId], references: [id], onDelete: Restrict)
    originInvoice      SubscriptionInvoice?             @relation(fields: [originInvoiceId], references: [id], onDelete: Restrict)
    originReversal     SubscriberReversal?              @relation("ReversalCredits", fields: [originReversalId], references: [id], onDelete: Restrict)
    originCancellation SubscriptionInvoiceCancellation? @relation(fields: [originCancellationId], references: [id], onDelete: Restrict)
    entries            SubscriberCreditEntry[]

    @@index([subscriberId, createdAt])
    @@index([originPaymentId])
    @@index([originReversalId])
    @@unique([originCancellationId, originPaymentId])
    @@map("subscriber_credits")
}

model SubscriberCreditEntry {
    id         String    @id @default(uuid())
    creditId   String
    kind       String // REFUND | REFUND_FAILED | PAYOUT | REVERSAL | REVERSAL_TAKEN_BACK
    // Positive: what a REFUND, a PAYOUT or a REVERSAL pays out, what a
    // REFUND_FAILED or a REVERSAL_TAKEN_BACK gives back.
    amount     Decimal   @db.Decimal(12, 2)
    // The refund, for a REFUND and its REFUND_FAILED.
    refundId   String?
    // The reversal, for a REVERSAL and its REVERSAL_TAKEN_BACK.
    reversalId String?
    // A payout's: the transfer's reference, the day it left, who recorded it.
    reference  String?
    paidOn     DateTime? @db.Date
    recordedBy String?
    note       String?
    recordedAt DateTime  @default(now())

    credit   SubscriberCredit    @relation(fields: [creditId], references: [id], onDelete: Restrict)
    refund   SubscriberRefund?   @relation(fields: [refundId], references: [id], onDelete: Restrict)
    reversal SubscriberReversal? @relation(fields: [reversalId], references: [id], onDelete: Restrict)

    @@unique([refundId, creditId, kind])
    @@index([creditId])
    @@index([reversalId])
    @@map("subscriber_credit_entries")
}

model SubscriberRefund {
    id             String    @id @default(uuid())
    subscriberId   String
    paymentId      String
    gatewayAccount String
    // The gateway's own reference to the refund, unique within its account.
    gatewayRef     String
    amount         Decimal   @db.Decimal(12, 2)
    currency       String
    status         String // PENDING | SUCCEEDED | FAILED | CANCELED
    recordedAt     DateTime  @default(now())
    // When it was recorded as failed or canceled.
    endedAt        DateTime?

    subscriber Subscriber                     @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    payment    SubscriberPayment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    entries    SubscriberCreditEntry[]
    cases      SubscriberReconciliationCase[]

    @@unique([gatewayAccount, gatewayRef])
    @@index([paymentId])
    @@map("subscriber_refunds")
}

model SubscriberReversal {
    id                String    @id @default(uuid())
    subscriberId      String
    // The tenant the payment's invoice was for, as a trace; no relation to it.
    tenantId          String
    paymentId         String
    gatewayAccount    String
    // The gateway's own reference to it, such as a dispute's, unique within its account.
    gatewayRef        String
    // What the gateway withdrew so far, positive.
    amount            Decimal   @db.Decimal(12, 2)
    currency          String
    // The part of `amount` taken from the credit the payment left, open or paid out.
    fromCredit        Decimal   @db.Decimal(12, 2)
    // What the gateway gave back of `amount` so far, a dispute won.
    reinstated        Decimal   @db.Decimal(12, 2)
    // The part of `reinstated` that covered the reversal's cases, written as it is given back.
    reinstatedToCases Decimal   @default(0) @db.Decimal(12, 2)
    recordedAt        DateTime  @default(now())
    // When the gateway last gave something back.
    reinstatedAt      DateTime?

    subscriber  Subscriber                     @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    payment     SubscriberPayment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    settlements SubscriptionInvoiceSettlement[]
    entries     SubscriberCreditEntry[]
    credits     SubscriberCredit[]             @relation("ReversalCredits")
    cases       SubscriberReconciliationCase[]

    @@unique([gatewayAccount, gatewayRef])
    @@index([paymentId])
    @@map("subscriber_reversals")
}

model SubscriberReconciliationCase {
    id             String    @id @default(uuid())
    subscriberId   String
    // The tenant the payment's invoice was for, as a trace; no relation to it.
    tenantId       String
    kind           String // REFUND_UNMATCHED | REVERSAL_UNMATCHED
    // What matched nothing, positive.
    amount         Decimal   @db.Decimal(12, 2)
    currency       String
    paymentId      String
    // Exactly what its kind is about: the refund, or the reversal.
    refundId       String?
    reversalId     String?
    gatewayAccount String
    // The refund's or the reversal's reference at the gateway.
    gatewayRef     String
    recordedAt     DateTime  @default(now())
    // Closed with a note; `closedBy` is empty where SaaSiCat closed it.
    closedAt       DateTime?
    closedBy       String?
    note           String?

    subscriber Subscriber          @relation(fields: [subscriberId], references: [id], onDelete: Restrict)
    payment    SubscriberPayment   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
    refund     SubscriberRefund?   @relation(fields: [refundId], references: [id], onDelete: Restrict)
    reversal   SubscriberReversal? @relation(fields: [reversalId], references: [id], onDelete: Restrict)

    @@unique([refundId])
    @@index([reversalId])
    @@index([closedAt, recordedAt])
    @@index([subscriberId, closedAt])
    @@map("subscriber_reconciliation_cases")
}

// =============================================================================
// SaaSiCat platform Prisma fragment: ContractConfirmation, ContractConfirmationArchive
// =============================================================================
//
// REFERENCE SNIPPET — see 01-subscription.prisma for conventions.
//
// What a subscriber keeps of the contract they are bound by (SC-AUD-016): a
// confirmation per contract the platform writes once confirmations exist
// (08-subscription-contract.prisma, `confirmationDue`), rendered from the
// contract, archived and mailed to the invoice email with the terms of the
// version the contract records.
//
// `ContractConfirmation` is where it stands: the checksum is recorded once,
// before the file is archived, and every later download is checked against it;
// the archive's confirmation and the delivery are set once each. A run claims
// the mail before it sends it, so of several instances one does.
//
// `ContractConfirmationArchive` keeps the file, written once and never changed:
// the migration `1.0-a-contract-confirmation-is-archived.postgres.sql`, run
// after `db push`, installs triggers that refuse every UPDATE, DELETE and
// TRUNCATE, whoever asks. Keep it, with its database backups, for as long as
// the contract is kept.
//
// Required with invoicing (`tenantBilling.chargeJournal.invoices`), whose start
// refuses invoices without a confirmation repository and archive.
//
// Contract: @saasicat/core (ContractConfirmationRepository,
// ContractConfirmationArchivePort).

model ContractConfirmation {
    contractId        String    @id
    // SHA-256 of the rendered file, 64 lower-case hex digits.
    checksum          String
    mediaType         String
    fileName          String
    // In bytes.
    size              Int
    renderedAt        DateTime
    // Null while the contract waits for its confirmation.
    archivedAt        DateTime?
    // When the run mailing it took it on; null while no run holds it.
    deliveryClaimedAt DateTime?
    // Null until the confirmation is handed to the mail.
    deliveredAt       DateTime?
    deliveredTo       String?

    contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

    @@index([archivedAt])
    @@map("contract_confirmations")
}

model ContractConfirmationArchive {
    contractId String   @id
    // SHA-256 of `content`, 64 lower-case hex digits.
    checksum   String
    mediaType  String
    fileName   String
    content    Bytes
    archivedAt DateTime

    contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

    @@map("contract_confirmation_archive")
}
